
---
import animeData from "../data/anime.json";
import { getRecommendations, type Anime } from "../lib/recommend";

const animeList = animeData.anime as (Anime & { poster?: string })[];
---

<section class="finder" id="anime-finder">
  <div class="heading">
    <span class="eyebrow">✦ DISCOVER YOUR NEXT WATCH</span>
    <h2>Find Anime That <span>Matches You.</span></h2>
    <p>Choose what you enjoy and let Bezels find your next favourite anime.</p>
  </div>

  <div class="filter-panel">
    <div class="filter-group">
      <h3><span class="step-number">01</span> Choose your genres</h3>
      <div class="options">
        {["Action", "Adventure", "Fantasy", "Comedy", "Romance", "Mystery", "Sci-Fi", "Drama", "Sports", "Horror", "Psychological", "Supernatural"].map((genre) => (
          <label class="choice">
            <input type="checkbox" name="genre" value={genre} />
            <span>{genre}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <h3><span class="step-number">02</span> What's your mood?</h3>
      <div class="options">
        {["Exciting", "Emotional", "Funny", "Dark", "Suspenseful", "Heartwarming", "Motivational", "Relaxed", "Mind-bending"].map((mood) => (
          <label class="choice">
            <input type="checkbox" name="mood" value={mood} />
            <span>{mood}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <h3><span class="step-number">03</span> How much time do you have?</h3>
      <select id="episodeLength">
        <option value="">Any episode count</option>
        <option value="short">Short — 13 episodes or less</option>
        <option value="medium">Medium — 14 to 26 episodes</option>
        <option value="long">Long — more than 26 episodes</option>
      </select>
    </div>

    <div class="filter-group">
      <h3><span class="step-number">04</span> Choose your story preference</h3>
      <div class="options">
        {["Adventure", "Coming-of-age", "Mystery", "Revenge", "Survival", "Time travel", "Tournament", "School life", "Investigation"].map((story) => (
          <label class="choice">
            <input type="checkbox" name="story" value={story} />
            <span>{story}</span>
          </label>
        ))}
      </div>
    </div>

    <button id="findAnime" type="button">Find My Anime <span>→</span></button>
    <p class="hint">✦ Select at least one preference to get recommendations.</p>
  </div>

  <div id="results" class="results" aria-live="polite"></div>
</section>

<script>
  import { getRecommendations, type Anime } from "../lib/recommend";
  import animeData from "../data/anime.json";

  const animeList = animeData.anime as (Anime & { poster?: string })[];
  const WATCHLIST_KEY = "bezels-watchlist";

  function getSavedIds(): string[] {
    try {
      const saved = localStorage.getItem(WATCHLIST_KEY);
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  }

  function saveAnime(id: string): boolean {
    const savedIds = getSavedIds();

    if (savedIds.includes(id)) {
      return false;
    }

    savedIds.push(id);
    localStorage.setItem(WATCHLIST_KEY, JSON.stringify(savedIds));

    window.dispatchEvent(new CustomEvent("bezels-watchlist-updated"));
    return true;
  }

  function setupFinder() {
    const button = document.querySelector<HTMLButtonElement>("#findAnime");
    const results = document.querySelector<HTMLDivElement>("#results");

    if (!button || !results || button.dataset.ready === "true") return;
    button.dataset.ready = "true";

    function selectedValues(name: string): string[] {
      return Array.from(
        document.querySelectorAll<HTMLInputElement>(
          `input[name="${name}"]:checked`
        )
      ).map((input) => input.value);
    }

    button.addEventListener("click", () => {
      const preferences = {
        genres: selectedValues("genre"),
        moods: selectedValues("mood"),
        storyTypes: selectedValues("story"),
        episodeLength:
          (document.querySelector<HTMLSelectElement>("#episodeLength")?.value ||
            undefined) as "short" | "medium" | "long" | undefined,
      };

      const hasPreference =
        preferences.genres.length > 0 ||
        preferences.moods.length > 0 ||
        preferences.storyTypes.length > 0 ||
        !!preferences.episodeLength;

      results.replaceChildren();

      if (!hasPreference) {
        results.textContent = "Please select at least one preference first.";
        return;
      }

      const recommendations = getRecommendations(animeList, preferences, 10);

      if (!recommendations.length) {
        results.textContent = "No matches found. Try changing your preferences.";
        return;
      }

      const heading = document.createElement("h3");
      heading.className = "results-heading";
      heading.textContent = "Your Anime Recommendations";

      const grid = document.createElement("div");
      grid.className = "result-grid";

      recommendations.forEach((anime) => {
        const card = document.createElement("article");
        card.className = "result-card";

        const posterBox = document.createElement("div");
        posterBox.className = "poster-box";

        const poster = document.createElement("img");
        poster.className = "anime-poster";
        poster.alt = `${anime.title} anime poster`;
        poster.loading = "lazy";
        poster.decoding = "async";

        const fallback = document.createElement("div");
        fallback.className = "poster-fallback";
        fallback.textContent = "Poster unavailable";

        if (anime.poster) {
          poster.src = anime.poster;
        } else {
          fallback.style.display = "flex";
        }

        poster.addEventListener("load", () => {
          poster.classList.add("loaded");
          fallback.style.display = "none";
        });

        poster.addEventListener("error", () => {
          poster.style.display = "none";
          fallback.textContent = "Poster unavailable";
          fallback.style.display = "flex";
        });

        posterBox.append(poster, fallback);

        const info = document.createElement("div");
        info.className = "card-info";

        const title = document.createElement("h4");
        title.className = "card-title";
        title.textContent = anime.title;

        const meta = document.createElement("p");
        meta.className = "meta";
        meta.textContent = `${anime.year} • ${anime.episodes} episodes`;

        const score = document.createElement("span");
        score.className = "score";
        score.textContent = `${anime.matchScore}% match`;

        const genres = document.createElement("p");
        genres.className = "genres";
        genres.textContent = anime.genres.join(" · ");

        const reason = document.createElement("p");
        reason.className = "reason";
        reason.textContent = anime.reasons.length
          ? `Why it matches: ${anime.reasons.join("; ")}`
          : "A possible match based on your selected preferences.";

        const saveButton = document.createElement("button");
        saveButton.className = "watchlist-button";

        function updateSaveButton() {
          const isSaved = getSavedIds().includes(anime.id);
          saveButton.textContent = isSaved
            ? "✓ Saved to Watchlist"
            : "+ Save to Watchlist";
          saveButton.classList.toggle("is-saved", isSaved);
        }

        updateSaveButton();

        saveButton.addEventListener("click", () => {
          const isSaved = getSavedIds().includes(anime.id);

          if (isSaved) {
            saveButton.textContent = "✓ Already Saved";
            return;
          }

          saveAnime(anime.id);
          updateSaveButton();
        });

        info.append(title, meta, score, genres, reason, saveButton);
        card.append(posterBox, info);
        grid.append(card);
      });

      results.append(heading, grid);
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    window.addEventListener("bezels-watchlist-updated", () => {
      results.querySelectorAll<HTMLButtonElement>(".watchlist-button").forEach((saveButton) => {
        const card = saveButton.closest(".result-card");
        const title = card?.querySelector(".card-title")?.textContent;
        const anime = animeList.find((item) => item.title === title);

        if (anime && getSavedIds().includes(anime.id)) {
          saveButton.textContent = "✓ Saved to Watchlist";
          saveButton.classList.add("is-saved");
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFinder, { once: true });
  } else {
    setupFinder();
  }
</script>

<style is:global>
  .finder {
    max-width: 1050px;
    margin: 0 auto;
    padding: 15px 0 30px;
    color: #f8f6ff;
  }

  .finder .heading {
    text-align: center;
    margin-bottom: 35px;
  }

  .finder .eyebrow {
    color: #b28aff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .finder .heading h2 {
    font-size: clamp(28px, 5vw, 40px);
    margin: 15px 0;
    letter-spacing: -1px;
  }

  .finder .heading h2 span {
    color: #b48aff;
    text-shadow: 0 0 18px rgba(168, 105, 255, 0.4);
  }

  .finder .heading p,
  .finder .hint {
    color: #aaa0bd;
    line-height: 1.8;
    font-size: 14px;
  }

  /* FILTER PANEL */

  .finder .filter-panel {
    position: relative;
    padding: 32px;
    border: 1px solid rgba(153, 112, 224, 0.25);
    border-radius: 15px;
    background: linear-gradient(145deg, #191326, #110e1c);
    box-shadow:
      0 0 30px rgba(111, 49, 196, 0.09),
      inset 0 0 25px rgba(140, 85, 220, 0.025);
  }

  .finder .filter-group {
    margin-bottom: 32px;
    padding-bottom: 27px;
    border-bottom: 1px solid rgba(163, 127, 216, 0.14);
  }

  .finder .filter-group h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #eee8ff;
    font-size: 16px;
    margin: 0 0 18px;
  }

  .finder .step-number {
    display: inline-grid;
    place-items: center;
    width: 31px;
    height: 31px;
    flex-shrink: 0;
    color: #c8aaff;
    background: rgba(145, 86, 255, 0.13);
    border: 1px solid rgba(174, 128, 255, 0.3);
    border-radius: 8px;
    font-size: 11px;
    letter-spacing: 1px;
    box-shadow: 0 0 13px rgba(133, 74, 230, 0.1);
  }

  .finder .options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .finder .choice {
    cursor: pointer;
  }

  .finder .choice input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .finder .choice span {
    display: block;
    padding: 10px 15px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(163, 127, 216, 0.23);
    border-radius: 8px;
    color: #c5bbd8;
    font-size: 13px;
    transition: 0.2s;
  }

  .finder .choice:hover span {
    color: white;
    border-color: rgba(180, 138, 255, 0.65);
    background: rgba(137, 76, 255, 0.1);
  }

  .finder .choice input:checked + span {
    background: linear-gradient(110deg, #7138d8, #9055e8);
    border-color: #c09aff;
    color: white;
    box-shadow: 0 0 16px rgba(139, 75, 255, 0.28);
  }

  .finder .choice input:focus-visible + span {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .finder select {
    width: 100%;
    padding: 14px;
    border-radius: 8px;
    background: #21182f;
    border: 1px solid rgba(163, 127, 216, 0.3);
    color: white;
    font-size: 14px;
    outline: none;
    color-scheme: dark;
  }

  .finder select:focus {
    border-color: #b48aff;
    box-shadow: 0 0 15px rgba(139, 75, 255, 0.18);
  }

  .finder #findAnime {
    width: 100%;
    padding: 16px;
    background: linear-gradient(110deg, #7138d8, #a15dff);
    border: 1px solid rgba(210, 179, 255, 0.35);
    border-radius: 9px;
    color: white;
    font-weight: bold;
    font-size: 15px;
    cursor: pointer;
    box-shadow: 0 0 22px rgba(139, 75, 255, 0.23);
    transition: 0.25s;
  }

  .finder #findAnime span {
    margin-left: 7px;
    font-size: 19px;
  }

  .finder #findAnime:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 32px rgba(157, 91, 255, 0.5);
  }

  .finder .hint {
    text-align: center;
    font-size: 12px;
    margin-top: 15px;
  }

  /* RESULTS */

  .finder .results {
    margin-top: 42px;
    scroll-margin-top: 30px;
  }

  .finder .results-heading {
    font-size: 25px;
    margin-bottom: 23px;
    color: #f7f1ff;
    text-shadow: 0 0 17px rgba(150, 90, 255, 0.2);
  }

  .finder .result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
  }

  .finder .result-card {
    overflow: hidden;
    background: linear-gradient(145deg, #191326, #110e1c);
    border: 1px solid rgba(153, 112, 224, 0.22);
    border-radius: 13px;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .finder .result-card:hover {
    transform: translateY(-5px);
    border-color: rgba(181, 137, 255, 0.7);
    box-shadow: 0 10px 30px rgba(111, 49, 196, 0.2);
  }

  .finder .poster-box {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: #1b1429;
    overflow: hidden;
  }

  .finder .anime-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.3s, transform 0.4s;
  }

  .finder .result-card:hover .anime-poster {
    transform: scale(1.035);
  }

  .finder .anime-poster.loaded {
    opacity: 1;
  }

  .finder .poster-fallback {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #b99aff;
    font-size: 13px;
    padding: 15px;
    background: radial-gradient(circle, #35234f, #171020);
  }

  .finder .card-info {
    padding: 18px;
  }

  .finder .card-title {
    color: #f7f1ff;
    font-size: 18px;
    line-height: 1.4;
    margin: 0 0 9px;
  }

  .finder .meta,
  .finder .genres,
  .finder .reason {
    color: #aaa0bd;
    font-size: 13px;
    line-height: 1.7;
    margin: 7px 0;
  }

  .finder .score {
    display: inline-block;
    color: #d6c1ff;
    background: rgba(145, 86, 255, 0.16);
    border: 1px solid rgba(174, 128, 255, 0.3);
    padding: 7px 11px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    margin: 12px 0;
    box-shadow: 0 0 12px rgba(133, 74, 230, 0.1);
  }

  .finder .watchlist-button {
    width: 100%;
    margin-top: 12px;
    padding: 12px;
    border: 1px solid rgba(174, 128, 255, 0.45);
    border-radius: 8px;
    background: rgba(145, 86, 255, 0.13);
    color: #d6c1ff;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
  }

  .finder .watchlist-button:hover {
    background: #7138d8;
    border-color: #c09aff;
    color: white;
    box-shadow: 0 0 18px rgba(139, 75, 255, 0.22);
  }

  .finder .watchlist-button.is-saved {
    background: rgba(31, 105, 82, 0.2);
    border-color: #398d71;
    color: #a8f0d5;
    cursor: default;
    box-shadow: none;
  }

  @media (max-width: 600px) {
    .finder {
      padding: 5px 0 20px;
    }

    .finder .filter-panel {
      padding: 22px 16px;
    }

    .finder .result-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .finder .card-info {
      padding: 13px;
    }

    .finder .card-title {
      font-size: 15px;
    }

    .finder .choice span {
      padding: 9px 12px;
      font-size: 12px;
    }
  }

  @media (max-width: 360px) {
    .finder .result-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
