
---
import animeData from "../data/anime.json";
import { getRecommendations, type Anime } from "../lib/recommend";

const animeList = animeData.anime as (Anime & { poster?: string })[];
---

<section class="finder" id="anime-finder">
  <div class="heading">
    <span class="eyebrow">DISCOVER YOUR NEXT WATCH</span>
    <h2>Find Anime That <span>Matches You.</span></h2>
    <p>Choose what you enjoy and let Bezels find your next favourite anime.</p>
  </div>

  <div class="filter-panel">
    <div class="filter-group">
      <h3>1. Choose your genres</h3>
      <div class="options">
        {["Action", "Adventure", "Fantasy", "Comedy", "Romance", "Mystery", "Sci-Fi", "Drama", "Sports", "Horror", "Psychological", "Supernatural"].map((genre) => (
          <label class="choice">
            <input type="checkbox" name="genre" value={genre} />
            <span>{genre}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <h3>2. What's your mood?</h3>
      <div class="options">
        {["Exciting", "Emotional", "Funny", "Dark", "Suspenseful", "Heartwarming", "Motivational", "Relaxed", "Mind-bending"].map((mood) => (
          <label class="choice">
            <input type="checkbox" name="mood" value={mood} />
            <span>{mood}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <h3>3. How much time do you have?</h3>
      <select id="episodeLength">
        <option value="">Any episode count</option>
        <option value="short">Short — 13 episodes or less</option>
        <option value="medium">Medium — 14 to 26 episodes</option>
        <option value="long">Long — more than 26 episodes</option>
      </select>
    </div>

    <div class="filter-group">
      <h3>4. Choose your story preference</h3>
      <div class="options">
        {["Adventure", "Coming-of-age", "Mystery", "Revenge", "Survival", "Time travel", "Tournament", "School life", "Investigation"].map((story) => (
          <label class="choice">
            <input type="checkbox" name="story" value={story} />
            <span>{story}</span>
          </label>
        ))}
      </div>
    </div>

    <button id="findAnime" type="button">Find My Anime →</button>
    <p class="hint">Select at least one preference to get recommendations.</p>
  </div>

  <div id="results" class="results" aria-live="polite"></div>
</section>

<script>
  import { getRecommendations, type Anime } from "../lib/recommend";
  import animeData from "../data/anime.json";

  const animeList = animeData.anime as (Anime & { poster?: string })[];
  const WATCHLIST_KEY = "bezels-watchlist";

  function getSavedIds(): string[] {
    try {
      const saved = localStorage.getItem(WATCHLIST_KEY);
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  }

  function saveAnime(id: string): boolean {
    const savedIds = getSavedIds();

    if (savedIds.includes(id)) {
      return false;
    }

    savedIds.push(id);
    localStorage.setItem(WATCHLIST_KEY, JSON.stringify(savedIds));

    window.dispatchEvent(new CustomEvent("bezels-watchlist-updated"));
    return true;
  }

  function setupFinder() {
    const button = document.querySelector<HTMLButtonElement>("#findAnime");
    const results = document.querySelector<HTMLDivElement>("#results");

    if (!button || !results || button.dataset.ready === "true") return;
    button.dataset.ready = "true";

    function selectedValues(name: string): string[] {
      return Array.from(
        document.querySelectorAll<HTMLInputElement>(
          `input[name="${name}"]:checked`
        )
      ).map((input) => input.value);
    }

    button.addEventListener("click", () => {
      const preferences = {
        genres: selectedValues("genre"),
        moods: selectedValues("mood"),
        storyTypes: selectedValues("story"),
        episodeLength:
          (document.querySelector<HTMLSelectElement>("#episodeLength")?.value ||
            undefined) as "short" | "medium" | "long" | undefined,
      };

      const hasPreference =
        preferences.genres.length > 0 ||
        preferences.moods.length > 0 ||
        preferences.storyTypes.length > 0 ||
        !!preferences.episodeLength;

      results.replaceChildren();

      if (!hasPreference) {
        results.textContent = "Please select at least one preference first.";
        return;
      }

      const recommendations = getRecommendations(animeList, preferences, 10);

      if (!recommendations.length) {
        results.textContent = "No matches found. Try changing your preferences.";
        return;
      }

      const heading = document.createElement("h3");
      heading.className = "results-heading";
      heading.textContent = "Your Anime Recommendations";

      const grid = document.createElement("div");
      grid.className = "result-grid";

      recommendations.forEach((anime) => {
        const card = document.createElement("article");
        card.className = "result-card";

        const posterBox = document.createElement("div");
        posterBox.className = "poster-box";

        const poster = document.createElement("img");
        poster.className = "anime-poster";
        poster.alt = `${anime.title} anime poster`;
        poster.loading = "lazy";
        poster.decoding = "async";

        const fallback = document.createElement("div");
        fallback.className = "poster-fallback";
        fallback.textContent = "Poster unavailable";

        if (anime.poster) {
          poster.src = anime.poster;
        } else {
          fallback.style.display = "flex";
        }

        poster.addEventListener("load", () => {
          poster.classList.add("loaded");
          fallback.style.display = "none";
        });

        poster.addEventListener("error", () => {
          poster.style.display = "none";
          fallback.textContent = "Poster unavailable";
          fallback.style.display = "flex";
        });

        posterBox.append(poster, fallback);

        const info = document.createElement("div");
        info.className = "card-info";

        const title = document.createElement("h4");
        title.className = "card-title";
        title.textContent = anime.title;

        const meta = document.createElement("p");
        meta.className = "meta";
        meta.textContent = `${anime.year} • ${anime.episodes} episodes`;

        const score = document.createElement("span");
        score.className = "score";
        score.textContent = `${anime.matchScore}% match`;

        const genres = document.createElement("p");
        genres.className = "genres";
        genres.textContent = anime.genres.join(" · ");

        const reason = document.createElement("p");
        reason.className = "reason";
        reason.textContent = anime.reasons.length
          ? `Why it matches: ${anime.reasons.join("; ")}`
          : "A possible match based on your selected preferences.";

        const saveButton = document.createElement("button");
        saveButton.className = "watchlist-button";

        function updateSaveButton() {
          const isSaved = getSavedIds().includes(anime.id);
          saveButton.textContent = isSaved
            ? "✓ Saved to Watchlist"
            : "+ Save to Watchlist";
          saveButton.classList.toggle("is-saved", isSaved);
        }

        updateSaveButton();

        saveButton.addEventListener("click", () => {
          const isSaved = getSavedIds().includes(anime.id);

          if (isSaved) {
            saveButton.textContent = "✓ Already Saved";
            return;
          }

          saveAnime(anime.id);
          updateSaveButton();
        });

        info.append(title, meta, score, genres, reason, saveButton);
        card.append(posterBox, info);
        grid.append(card);
      });

      results.append(heading, grid);
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    window.addEventListener("bezels-watchlist-updated", () => {
      results.querySelectorAll<HTMLButtonElement>(".watchlist-button").forEach((saveButton) => {
        const card = saveButton.closest(".result-card");
        const title = card?.querySelector(".card-title")?.textContent;
        const anime = animeList.find((item) => item.title === title);

        if (anime && getSavedIds().includes(anime.id)) {
          saveButton.textContent = "✓ Saved to Watchlist";
          saveButton.classList.add("is-saved");
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFinder, { once: true });
  } else {
    setupFinder();
  }
</script>

<style is:global>
  .finder {
    max-width: 1050px;
    margin: 30px auto 90px;
    padding: 35px 22px;
    color: #f5f5ff;
  }

  .finder .heading {
    text-align: center;
    margin-bottom: 35px;
  }

  .finder .eyebrow {
    color: #a99aff;
    font-size: 12px;
    letter-spacing: 2px;
  }

  .finder .heading h2 {
    font-size: clamp(30px, 5vw, 43px);
    margin: 14px 0;
  }

  .finder .heading h2 span {
    color: #9685ff;
  }

  .finder .heading p,
  .finder .hint {
    color: #aab2c6;
    line-height: 1.7;
  }

  .finder .filter-panel {
    background: #111a2c;
    border: 1px solid #25304a;
    padding: 28px;
    border-radius: 16px;
  }

  .finder .filter-group {
    margin-bottom: 30px;
  }

  .finder .filter-group h3 {
    font-size: 17px;
    margin-bottom: 16px;
  }

  .finder .options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .finder .choice {
    cursor: pointer;
  }

  .finder .choice input {
    position: absolute;
    opacity: 0;
  }

  .finder .choice span {
    display: block;
    padding: 10px 15px;
    background: #1b2740;
    border: 1px solid #34415e;
    border-radius: 8px;
    color: #d4daeb;
    font-size: 13px;
    transition: 0.2s;
  }

  .finder .choice input:checked + span {
    background: #5544b9;
    border-color: #a394ff;
    color: white;
  }

  .finder .choice input:focus-visible + span {
    outline: 2px solid white;
  }

  .finder select {
    width: 100%;
    padding: 14px;
    border-radius: 8px;
    background: #1b2740;
    border: 1px solid #34415e;
    color: white;
  }

  .finder #findAnime {
    width: 100%;
    padding: 16px;
    background: #7965f5;
    border: 0;
    border-radius: 9px;
    color: white;
    font-weight: bold;
    font-size: 15px;
    cursor: pointer;
  }

  .finder #findAnime:hover {
    background: #6853e6;
  }

  .finder .hint {
    text-align: center;
    font-size: 12px;
    margin-top: 13px;
  }

  .finder .results {
    margin-top: 35px;
    scroll-margin-top: 30px;
  }

  .finder .results-heading {
    font-size: 24px;
    margin-bottom: 20px;
  }

  .finder .result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
  }

  .finder .result-card {
    overflow: hidden;
    background: #111a2c;
    border: 1px solid #293650;
    border-radius: 14px;
    transition: transform 0.2s, border-color 0.2s;
  }

  .finder .result-card:hover {
    transform: translateY(-4px);
    border-color: #7965f5;
  }

  .finder .poster-box {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: #1b2740;
    overflow: hidden;
  }

  .finder .anime-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .finder .anime-poster.loaded {
    opacity: 1;
  }

  .finder .poster-fallback {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #aab2c6;
    font-size: 13px;
    padding: 15px;
  }

  .finder .card-info {
    padding: 18px;
  }

  .finder .card-title {
    color: white;
    font-size: 18px;
    line-height: 1.4;
    margin: 0 0 9px;
  }

  .finder .meta,
  .finder .genres,
  .finder .reason {
    color: #aab2c6;
    font-size: 13px;
    line-height: 1.7;
    margin: 7px 0;
  }

  .finder .score {
    display: inline-block;
    color: #c2b7ff;
    background: #30285b;
    padding: 7px 11px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    margin: 12px 0;
  }

  .finder .watchlist-button {
    width: 100%;
    margin-top: 12px;
    padding: 12px;
    border: 1px solid #7965f5;
    border-radius: 8px;
    background: #30285b;
    color: white;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
  }

  .finder .watchlist-button:hover {
    background: #5544b9;
  }

  .finder .watchlist-button.is-saved {
    background: #183b35;
    border-color: #3b9b7d;
    color: #a8f0d5;
    cursor: default;
  }

  @media (max-width: 600px) {
    .finder {
      padding: 25px 15px;
    }

    .finder .filter-panel {
      padding: 20px 15px;
    }

    .finder .result-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .finder .card-info {
      padding: 13px;
    }

    .finder .card-title {
      font-size: 15px;
    }
  }

  @media (max-width: 360px) {
    .finder .result-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
