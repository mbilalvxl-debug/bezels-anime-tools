
<section class="detail-quiz" id="detailed-quiz">
  <div class="quiz-heading">
    <span class="quiz-eyebrow">✦ THE BEZELS ANIME QUIZ</span>
    <h2>Find Your <span>Perfect Anime.</span></h2>
    <p>Answer 6 quick questions and discover anime matched to your taste.</p>
  </div>

  <div class="quiz-panel">
    <div class="progress-info">
      <span id="quizStepLabel">STEP 1 OF 6</span>
      <span id="quizProgressPercent">17%</span>
    </div>

    <div class="progress-track">
      <div class="progress-fill" id="quizProgress"></div>
    </div>

    <div class="quiz-step active" data-step="0">
      <h3>What genres do you enjoy?</h3>
      <p class="step-description">Select all that you like.</p>
      <div class="quiz-options">
        {["Action", "Adventure", "Fantasy", "Comedy", "Romance", "Mystery", "Sci-Fi", "Drama", "Sports", "Horror", "Psychological", "Supernatural", "Thriller", "Slice of Life", "Historical", "Mecha", "Music"].map((item) => (
          <button type="button" class="quiz-option" data-group="genres" data-value={item}>{item}</button>
        ))}
      </div>
    </div>

    <div class="quiz-step" data-step="1">
      <h3>What kind of mood are you looking for?</h3>
      <p class="step-description">Choose the vibes you want.</p>
      <div class="quiz-options">
        {["Exciting", "Emotional", "Funny", "Dark", "Intense", "Suspenseful", "Heartwarming", "Motivational", "Relaxed", "Mind-bending", "Lighthearted", "Melancholic"].map((item) => (
          <button type="button" class="quiz-option" data-group="moods" data-value={item}>{item}</button>
        ))}
      </div>
    </div>

    <div class="quiz-step" data-step="2">
      <h3>What type of story interests you?</h3>
      <p class="step-description">Select your favourite story elements.</p>
      <div class="quiz-options">
        {["Adventure", "Mystery", "Revenge", "Survival", "Time travel", "Tournament", "School life", "Coming-of-age", "War", "Friendship", "Investigation", "Mind games", "Romance", "Rebellion", "Competition", "World exploration", "Journey", "Escape"].map((item) => (
          <button type="button" class="quiz-option" data-group="storyTypes" data-value={item}>{item}</button>
        ))}
      </div>
    </div>

    <div class="quiz-step" data-step="3">
      <h3>What kind of main character do you prefer?</h3>
      <p class="step-description">Choose the protagonist types you enjoy.</p>
      <div class="quiz-options">
        {["Overpowered", "Underdog", "Intelligent", "Determined", "Unpredictable", "Kind-hearted", "Optimistic", "Strategic", "Conflicted", "Funny", "Introverted", "Mysterious", "Relatable", "Evolving", "Protective", "Competitive"].map((item) => (
          <button type="button" class="quiz-option" data-group="protagonistTypes" data-value={item}>{item}</button>
        ))}
      </div>
    </div>

    <div class="quiz-step" data-step="4">
      <h3>How long should the anime be?</h3>
      <p class="step-description">Choose your preferred episode count.</p>
      <div class="quiz-options vertical-options">
        <button type="button" class="quiz-option single-option" data-group="episodeLength" data-value="short">
          <strong>Short</strong><small>13 episodes or less</small>
        </button>
        <button type="button" class="quiz-option single-option" data-group="episodeLength" data-value="medium">
          <strong>Medium</strong><small>14 to 26 episodes</small>
        </button>
        <button type="button" class="quiz-option single-option" data-group="episodeLength" data-value="long">
          <strong>Long</strong><small>More than 26 episodes</small>
        </button>
      </div>
    </div>

    <div class="quiz-step" data-step="5">
      <h3>Which anime era do you prefer?</h3>
      <p class="step-description">Choose the release period.</p>
      <div class="quiz-options vertical-options">
        <button type="button" class="quiz-option single-option" data-group="releasePeriod" data-value="classic">
          <strong>Classic anime</strong><small>Before 2010</small>
        </button>
        <button type="button" class="quiz-option single-option" data-group="releasePeriod" data-value="2010s">
          <strong>2010s anime</strong><small>2010 to 2019</small>
        </button>
        <button type="button" class="quiz-option single-option" data-group="releasePeriod" data-value="2020s">
          <strong>Modern anime</strong><small>2020 onwards</small>
        </button>
      </div>
    </div>

    <p class="quiz-error" id="quizError" aria-live="polite">Loading anime database...</p>

    <div class="quiz-navigation">
      <button type="button" id="quizBack" class="quiz-back" disabled>← Back</button>
      <button type="button" id="quizNext" class="quiz-next" disabled>Loading Anime...</button>
    </div>
  </div>

  <div class="quiz-results" id="quizResults" aria-live="polite"></div>
</section>

<script>
  import { supabase } from "../lib/supabase";
  import {
    getRecommendations,
    type Anime,
    type RecommendationPreferences
  } from "../lib/recommend";

  type QuizAnime = Anime & { poster?: string };

  let animeList: QuizAnime[] = [];

  const WATCHLIST_KEY = "bezels-watchlist";

  function getSavedIds(): string[] {
    try {
      const saved = localStorage.getItem(WATCHLIST_KEY);
      const parsed = saved ? JSON.parse(saved) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function saveAnime(id: string): boolean {
    const savedIds = getSavedIds();

    if (savedIds.includes(id)) return false;

    savedIds.push(id);
    localStorage.setItem(WATCHLIST_KEY, JSON.stringify(savedIds));

    window.dispatchEvent(new CustomEvent("bezels-watchlist-updated"));
    return true;
  }

  function setupDetailedQuiz() {
    const root = document.querySelector<HTMLElement>("#detailed-quiz");

    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const steps = Array.from(root.querySelectorAll<HTMLElement>(".quiz-step"));
    const nextButton = root.querySelector<HTMLButtonElement>("#quizNext");
    const backButton = root.querySelector<HTMLButtonElement>("#quizBack");
    const progress = root.querySelector<HTMLElement>("#quizProgress");
    const stepLabel = root.querySelector<HTMLElement>("#quizStepLabel");
    const percentLabel = root.querySelector<HTMLElement>("#quizProgressPercent");
    const error = root.querySelector<HTMLElement>("#quizError");
    const results = root.querySelector<HTMLElement>("#quizResults");
    const panel = root.querySelector<HTMLElement>(".quiz-panel");

    if (!nextButton || !backButton || !progress || !stepLabel || !percentLabel || !error || !results) return;

    let currentStep = 0;

    const answers: Record<string, string[]> = {
      genres: [],
      moods: [],
      storyTypes: [],
      protagonistTypes: [],
      episodeLength: [],
      releasePeriod: []
    };

    async function loadAnimeDatabase() {
      nextButton.disabled = true;
      nextButton.textContent = "Loading Anime...";
      error.textContent = "Loading anime database...";

      try {
        const { data, error: fetchError } = await supabase
          .from("anime")
          .select("*")
          .order("title", { ascending: true });

        if (fetchError) {
          throw fetchError;
        }

        animeList = (data ?? []).map((row) => ({
          id: row.id,
          title: row.title,
          year: row.year == null ? Number.NaN : Number(row.year),
          episodes: row.episodes == null ? Number.NaN : Number(row.episodes),
          status: row.status ?? "Unknown",
          genres: Array.isArray(row.genres) ? row.genres : [],
          moods: Array.isArray(row.moods) ? row.moods : [],
          storyTypes: Array.isArray(row.story_types) ? row.story_types : [],
          protagonistTypes: Array.isArray(row.protagonist_types) ? row.protagonist_types : [],
          contentNotes: Array.isArray(row.content_notes) ? row.content_notes : [],
          poster: row.poster ?? undefined
        }));

        if (animeList.length === 0) {
          error.textContent = "No anime found in the database. Please add anime through Anime Manager.";
          nextButton.textContent = "Database Empty";
          return;
        }

        error.textContent = "";
        nextButton.disabled = false;
        nextButton.textContent = "Next Step →";

      } catch (fetchError) {
        console.error("Anime Quiz database error:", fetchError);

        error.textContent = "Unable to load anime database. Please refresh the page and try again.";
        nextButton.textContent = "Database Error";
      }
    }

    function updateStep() {
      steps.forEach((step, index) => {
        step.classList.toggle("active", index === currentStep);
      });

      const percentage = Math.round(((currentStep + 1) / steps.length) * 100);

      progress.style.width = `${percentage}%`;
      stepLabel.textContent = `STEP ${currentStep + 1} OF ${steps.length}`;
      percentLabel.textContent = `${percentage}%`;

      backButton.disabled = currentStep === 0;

      nextButton.textContent =
        currentStep === steps.length - 1
          ? "Find My Anime →"
          : "Next Step →";

      error.textContent = "";
    }

    root.querySelectorAll<HTMLButtonElement>(".quiz-option").forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.dataset.group;
        const value = button.dataset.value;

        if (!group || !value) return;

        if (group === "episodeLength" || group === "releasePeriod") {
          answers[group] = answers[group].includes(value) ? [] : [value];

          root.querySelectorAll<HTMLButtonElement>(`.quiz-option[data-group="${group}"]`).forEach((option) => {
            option.classList.toggle(
              "selected",
              answers[group].includes(option.dataset.value || "")
            );
          });
        } else {
          if (answers[group].includes(value)) {
            answers[group] = answers[group].filter((item) => item !== value);
          } else {
            answers[group].push(value);
          }

          button.classList.toggle("selected", answers[group].includes(value));
        }

        error.textContent = "";
      });
    });

    backButton.addEventListener("click", () => {
      if (currentStep > 0) {
        currentStep--;
        updateStep();
      }
    });

    nextButton.addEventListener("click", () => {
      if (nextButton.disabled) return;

      if (currentStep < steps.length - 1) {
        currentStep++;
        updateStep();
        return;
      }

      const hasAnswers = Object.values(answers).some((items) => items.length > 0);

      if (!hasAnswers) {
        error.textContent = "Please select at least one preference before finding your anime.";
        return;
      }

      const preferences: RecommendationPreferences = {
        genres: answers.genres,
        moods: answers.moods,
        storyTypes: answers.storyTypes,
        protagonistTypes: answers.protagonistTypes,
        episodeLength: answers.episodeLength[0] as RecommendationPreferences["episodeLength"],
        releasePeriod: answers.releasePeriod[0] as RecommendationPreferences["releasePeriod"]
      };

      const recommendations = getRecommendations(animeList, preferences, 10);

      showResults(recommendations);
    });

    function showResults(recommendations: ReturnType<typeof getRecommendations>) {
      const heading = document.createElement("h3");
      heading.className = "quiz-results-title";
      heading.textContent = "Your Anime Recommendations";

      const description = document.createElement("p");
      description.className = "quiz-results-description";
      description.textContent = "Here are the anime that best match your answers.";

      const grid = document.createElement("div");
      grid.className = "quiz-result-grid";

      if (!recommendations.length || recommendations[0].matchScore === 0) {
        const message = document.createElement("p");
        message.className = "quiz-no-results";
        message.textContent = "We couldn't find a close match. Try changing your answers and take the quiz again.";

        results.replaceChildren(heading, description, message);
      } else {
        recommendations.forEach((anime) => {
          const card = document.createElement("article");
          card.className = "quiz-result-card";

          const posterBox = document.createElement("div");
          posterBox.className = "quiz-poster-box";

          const posterUrl = animeList.find((item) => item.id === anime.id)?.poster;

          if (posterUrl) {
            const poster = document.createElement("img");
            poster.src = posterUrl;
            poster.alt = `${anime.title} anime poster`;
            poster.loading = "lazy";

            poster.onerror = () => {
              poster.style.display = "none";
              posterBox.textContent = "Poster unavailable";
            };

            posterBox.append(poster);
          } else {
            posterBox.textContent = "Poster unavailable";
          }

          const info = document.createElement("div");
          info.className = "quiz-card-info";

          const title = document.createElement("h4");
          title.textContent = anime.title;

          const yearText = Number.isFinite(anime.year)
            ? String(anime.year)
            : "Year unknown";

          const episodeText = Number.isFinite(anime.episodes)
            ? `${anime.episodes} episodes`
            : "Episodes unknown";

          const meta = document.createElement("p");
          meta.className = "quiz-meta";
          meta.textContent = `${yearText} • ${episodeText} • ${anime.status}`;

          const score = document.createElement("span");
          score.className = "quiz-score";
          score.textContent = `${anime.matchScore}% match`;

          const genres = document.createElement("p");
          genres.className = "quiz-genres";
          genres.textContent = anime.genres.join(" · ");

          const reason = document.createElement("p");
          reason.className = "quiz-reason";
          reason.textContent = anime.reasons.length
            ? `Why it matches: ${anime.reasons.join("; ")}`
            : "This anime matches some of your selected preferences.";

          const saveButton = document.createElement("button");
          saveButton.type = "button";
          saveButton.className = "quiz-watchlist-button";
          saveButton.dataset.animeId = anime.id;

          function updateSaveButton() {
            const isSaved = getSavedIds().includes(anime.id);

            saveButton.textContent = isSaved
              ? "✓ Saved to Watchlist"
              : "+ Save to Watchlist";

            saveButton.classList.toggle("is-saved", isSaved);
          }

          updateSaveButton();

          saveButton.addEventListener("click", () => {
            if (getSavedIds().includes(anime.id)) {
              updateSaveButton();
              return;
            }

            saveAnime(anime.id);
            updateSaveButton();
          });

          info.append(title, meta, score, genres, reason, saveButton);
          card.append(posterBox, info);
          grid.append(card);
        });

        results.replaceChildren(heading, description, grid);
      }

      panel?.classList.add("quiz-completed");
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    window.addEventListener("bezels-watchlist-updated", () => {
      results.querySelectorAll<HTMLButtonElement>(".quiz-watchlist-button").forEach((button) => {
        const animeId = button.dataset.animeId;

        if (animeId && getSavedIds().includes(animeId)) {
          button.textContent = "✓ Saved to Watchlist";
          button.classList.add("is-saved");
        }
      });
    });

    updateStep();
    loadAnimeDatabase();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupDetailedQuiz, { once: true });
  } else {
    setupDetailedQuiz();
  }
</script>

<style is:global>
  .detail-quiz {
    max-width: 1050px;
    margin: 35px auto 60px;
    padding: 15px 0 30px;
    color: #f8f6ff;
  }

