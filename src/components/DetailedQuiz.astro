    margin: 15px 0;
    letter-spacing: -1px;
  }

  .quiz-heading h2 span {
    color: #b48aff;
    text-shadow: 0 0 18px rgba(168, 105, 255, 0.4);
  }

  .quiz-heading p,
  .step-description {
    color: #aaa0bd;
    line-height: 1.8;
    font-size: 14px;
  }

  .quiz-panel {
    background: linear-gradient(145deg, #191326, #110e1c);
    border: 1px solid rgba(153, 112, 224, 0.25);
    border-radius: 15px;
