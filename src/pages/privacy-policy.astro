
---
import Footer from "../components/Footer.astro";

const title = "Privacy Policy | Bezels";
const description =
  "Read the Bezels Privacy Policy to understand how information, browser storage and website usage are handled.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: #090d18;
        color: #f4f6ff;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 8%;
        border-bottom: 1px solid #20283b;
      }

      .logo {
        color: white;
        font-size: 27px;
        font-weight: 800;
        text-decoration: none;
      }

      .logo span { color: #8b7cff; }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      nav a {
        color: #b9bfd1;
        text-decoration: none;
        font-size: 14px;
      }

      nav a:hover { color: #a99aff; }

      main {
        max-width: 850px;
        margin: auto;
        padding: 70px 22px 90px;
      }

      .eyebrow {
        color: #a99aff;
        font-size: 12px;
        letter-spacing: 2px;
      }

      h1 {
        font-size: clamp(36px, 6vw, 52px);
        margin: 18px 0;
      }

      h1 span { color: #9685ff; }

      .updated {
        color: #828da5;
        font-size: 13px;
        margin-bottom: 30px;
      }

      .intro {
        color: #b9bfd1;
        font-size: 16px;
        line-height: 1.9;
        margin-bottom: 35px;
      }

      .policy-section { margin-top: 30px; }

      .policy-section h2 {
        font-size: 21px;
        margin-bottom: 12px;
      }

      .policy-section p,
      .policy-section li {
        color: #aab2c6;
        font-size: 14px;
        line-height: 1.9;
      }

      .policy-section ul {
        margin: 12px 0 0 22px;
      }

      .policy-section a {
        color: #b9aaff;
        overflow-wrap: anywhere;
      }

      @media (max-width: 650px) {
        header {
          padding: 20px;
          flex-direction: column;
          gap: 18px;
        }

        nav {
          justify-content: center;
          gap: 13px;
        }

        nav a { font-size: 12px; }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">BEZELS<span>.</span></a>

      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/">Articles</a>
      </nav>
    </header>

    <main>
      <span class="eyebrow">YOUR PRIVACY MATTERS</span>

      <h1>Privacy <span>Policy.</span></h1>

      <p class="updated">Last updated: November 7, 2026</p>

      <p class="intro">
        This Privacy Policy explains how Bezels handles information
        when visitors use our website and its anime discovery tools.
        By using Bezels, you acknowledge the practices described here.
      </p>

      <section class="policy-section">
        <h2>1. Information We Collect</h2>
        <p>
          Bezels does not currently require visitors to create an
          account to use its anime recommendation tools. Information
          you voluntarily send to us through email may include your
          email address and the contents of your message.
        </p>
      </section>

      <section class="policy-section">
        <h2>2. Browser Storage and Watchlist</h2>
        <p>
          Our anime finder, quiz and watchlist may use your browser's
          local storage to remember saved anime and watched titles.
          This information is stored in your browser on your device.
          It is not an account-based cloud watchlist and may not
          transfer to another browser or device. Clearing browser
          data may remove saved information.
        </p>
      </section>

      <section class="policy-section">
        <h2>3. How We Use Information</h2>
        <p>
          Information voluntarily provided through email may be used
          to respond to enquiries, understand feedback and improve
          the website. Browser-stored preferences are used to make
          the website's tools work as intended.
        </p>
      </section>

      <section class="policy-section">
        <h2>4. Cookies and Third-Party Services</h2>
        <p>
          Bezels may use third-party services for website hosting,
          analytics, advertising or other functionality in the future.
          These providers may use cookies or similar technologies
          according to their own privacy policies.
        </p>
        <p style="margin-top: 12px;">
          If advertising services such as Google AdSense are added,
          they may use cookies to serve, measure and personalise ads
          where permitted by applicable settings and consent rules.
          Visitors should review the relevant third-party policies.
        </p>
      </section>

      <section class="policy-section">
        <h2>5. Third-Party Links</h2>
        <p>
          Our website may contain links to external websites or
          services. Bezels does not control the privacy practices
          or content of those websites. We encourage visitors to
          read their policies before sharing information.
        </p>
      </section>

      <section class="policy-section">
        <h2>6. Data Security</h2>
        <p>
          We take reasonable steps to maintain the website and
          protect information shared with us. However, no method
          of internet transmission or electronic storage can be
          guaranteed to be completely secure.
        </p>
      </section>

      <section class="policy-section">
        <h2>7. Children's Privacy</h2>
        <p>
          Bezels is intended for a general audience of anime fans.
          We do not knowingly request personal information from
          children through our recommendation tools. Parents or
          guardians who have concerns about information submitted
          to us can contact us.
        </p>
      </section>

      <section class="policy-section">
        <h2>8. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy when our website,
          features or practices change. Updated information will
          be published on this page with a revised date.
        </p>
      </section>

      <section class="policy-section">
        <h2>9. Contact Us</h2>
        <p>
          If you have questions about this Privacy Policy, contact
          us at
          <a href="mailto:mbilalvxl@gmail.com">mbilalvxl@gmail.com</a>.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>
