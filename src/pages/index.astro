
---
import Footer from "../components/Footer.astro";

const title = "Bezels — Discover Your Next Favourite Anime";
const description =
  "Find your next favourite anime with Bezels. Explore anime recommendations, take a personalised quiz and organise your watchlist.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #090d18;
        color: #f4f6ff;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 23px 8%;
        border-bottom: 1px solid #20283b;
      }

      .logo {
        color: white;
        font-size: 27px;
        font-weight: 800;
        text-decoration: none;
      }

      .logo span { color: #8b7cff; }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 23px;
      }

      nav a {
        color: #b9bfd1;
        text-decoration: none;
        font-size: 14px;
      }

      nav a:hover { color: #a99aff; }

      .hero {
        max-width: 950px;
        margin: auto;
        padding: 115px 22px 100px;
        text-align: center;
      }

      .tag {
        display: inline-block;
        border: 1px solid #5548a9;
        color: #b9aaff;
        padding: 9px 16px;
        border-radius: 30px;
        font-size: 12px;
        letter-spacing: 1px;
        margin-bottom: 28px;
      }

      h1 {
        font-size: clamp(42px, 7vw, 72px);
        line-height: 1.1;
        letter-spacing: -2px;
        margin-bottom: 25px;
      }

      h1 span { color: #9685ff; }

      .hero p {
        color: #aab2c6;
        font-size: 17px;
        line-height: 1.9;
        max-width: 680px;
        margin: 0 auto 35px;
      }

      .cta {
        display: inline-block;
        background: #7965f5;
        color: white;
        padding: 16px 27px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.2s;
      }

      .cta:hover { background: #6651e6; }

      .section {
        max-width: 1100px;
        margin: 0 auto;
        padding: 35px 22px 85px;
      }

      .section-heading {
        text-align: center;
        margin-bottom: 35px;
      }

      .section-heading h2 {
        font-size: 30px;
        margin-bottom: 13px;
      }

      .section-heading p {
        color: #aab2c6;
        line-height: 1.7;
        font-size: 15px;
      }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .tool-card {
        display: block;
        background: #111a2c;
        border: 1px solid #293650;
        border-radius: 15px;
        padding: 28px;
        text-decoration: none;
        color: white;
        transition: transform 0.2s, border-color 0.2s;
      }

      .tool-card:hover {
        transform: translateY(-5px);
        border-color: #7965f5;
      }

      .tool-icon {
        font-size: 30px;
        margin-bottom: 20px;
      }

      .tool-card h3 {
        font-size: 20px;
        margin-bottom: 13px;
      }

      .tool-card p {
        color: #aab2c6;
        font-size: 14px;
        line-height: 1.8;
        margin-bottom: 20px;
      }

      .tool-link {
        color: #a99aff;
        font-size: 13px;
        font-weight: bold;
      }

      .about {
        max-width: 850px;
        margin: 0 auto 80px;
        padding: 40px 25px;
        text-align: center;
        background: #111a2c;
        border: 1px solid #293650;
        border-radius: 16px;
      }

      .about h2 {
        font-size: 27px;
        margin-bottom: 17px;
      }

      .about p {
        color: #aab2c6;
        font-size: 15px;
        line-height: 1.9;
      }

      .articles-link {
        display: inline-block;
        margin-top: 22px;
        color: #b9aaff;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
      }

      @media (max-width: 750px) {
        header {
          padding: 20px;
          flex-direction: column;
          gap: 18px;
        }

        nav {
          justify-content: center;
          gap: 15px;
        }

        nav a { font-size: 12px; }

        .hero { padding: 85px 22px 75px; }

        .tools-grid { grid-template-columns: 1fr; }

        .section-heading h2 { font-size: 25px; }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">BEZELS<span>.</span></a>

      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/">Articles</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="tag">YOUR NEXT ANIME STARTS HERE</div>

        <h1>Discover Your Next <span>Favourite Anime.</span></h1>

        <p>
          Not sure what to watch next? Explore anime based on your
          favourite genres, mood and storytelling preferences.
          Take our anime quiz, discover new series and keep your
          watchlist organised — all in one place.
        </p>

        <a class="cta" href="/find-anime/">Find Your Next Anime</a>
      </section>

      <section class="section">
        <div class="section-heading">
          <h2>Explore Bezels Tools</h2>
          <p>
            Everything you need to discover and organise your next anime.
          </p>
        </div>

        <div class="tools-grid">
          <a class="tool-card" href="/find-anime/">
            <div class="tool-icon">🎯</div>
            <h3>Quick Anime Finder</h3>
            <p>
              Choose genres, moods and episode preferences to
              discover anime that match your interests.
            </p>
            <span class="tool-link">Explore Finder →</span>
          </a>

          <a class="tool-card" href="/anime-quiz/">
            <div class="tool-icon">🧩</div>
            <h3>Anime Recommendation Quiz</h3>
            <p>
              Answer a series of questions about your anime taste
              and get recommendations based on your choices.
            </p>
            <span class="tool-link">Take the Quiz →</span>
          </a>

          <a class="tool-card" href="/watchlist/">
            <div class="tool-icon">📌</div>
            <h3>My Anime Watchlist</h3>
            <p>
              Save anime you want to watch, track completed titles
              and keep your personal collection organised.
            </p>
            <span class="tool-link">Open Watchlist →</span>
          </a>
        </div>
      </section>

      <section class="about">
        <h2>Welcome to Bezels</h2>
        <p>
          Bezels is an anime discovery platform built to make finding
          your next series easier. Whether you enjoy action, fantasy,
          romance, mystery or something completely different, our
          tools help you explore anime according to your preferences.
          You can also visit our articles section for anime guides
          and helpful information.
        </p>

        <a class="articles-link" href="/articles/">
          Explore Anime Articles →
        </a>
      </section>
    </main>

    <Footer />
  </body>
</html>
