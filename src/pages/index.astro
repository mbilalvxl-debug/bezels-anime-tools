
---
import Footer from "../components/Footer.astro";

const title = "Bezels — Discover Your Next Favourite Anime";
const description =
  "Find your next favourite anime with Bezels. Explore anime recommendations, take a personalised quiz and organise your watchlist.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">BEZELS<span>.</span></a>

      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/">Articles</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <span class="eyebrow">YOUR ANIME DISCOVERY HUB</span>

        <h1>Discover Your Next <span>Favourite Anime</span></h1>

        <p>
          Not sure what to watch next? Explore anime recommendations,
          discover new series and build your personal watchlist with Bezels.
        </p>

        <div class="hero-buttons">
          <a href="/find-anime/" class="primary-btn">Find Your Anime</a>
          <a href="/anime-quiz/" class="secondary-btn">Take Anime Quiz</a>
        </div>
      </section>

      <section class="tools-section">
        <div class="section-heading">
          <span class="eyebrow">EXPLORE BEZELS</span>
          <h2>What Would You Like to Do?</h2>
          <p>Choose a tool and start exploring.</p>
        </div>

        <div class="tools-grid">
          <a href="/find-anime/" class="tool-card">
            <div class="tool-icon">⌕</div>
            <h3>Find Anime</h3>
            <p>
              Discover anime based on your favourite genres, mood,
              story preferences and episode count.
            </p>
            <span class="card-link">Explore Anime →</span>
          </a>

          <a href="/anime-quiz/" class="tool-card">
            <div class="tool-icon">✦</div>
            <h3>Anime Quiz</h3>
            <p>
              Answer a few questions about your preferences and
              get anime recommendations that match your interests.
            </p>
            <span class="card-link">Take the Quiz →</span>
          </a>

          <a href="/watchlist/" class="tool-card">
            <div class="tool-icon">▤</div>
            <h3>My Watchlist</h3>
            <p>
              Keep track of anime you want to watch and organise
              the series you have already completed.
            </p>
            <span class="card-link">Open Watchlist →</span>
          </a>
        </div>
      </section>

      <section class="about-section">
        <span class="eyebrow">ABOUT BEZELS</span>
        <h2>Made for Anime Fans</h2>

        <p>
          Bezels is an anime discovery platform designed to make
          finding your next series easier. Whether you enjoy action,
          fantasy, mystery, romance or something completely different,
          our tools help you explore anime based on what you love.
        </p>

        <a href="/about/" class="about-link">Learn More About Bezels →</a>
      </section>

      <section class="articles-section">
        <h2>Explore Anime Guides & Articles</h2>
        <p>
          Read helpful anime guides, explore different genres and
          discover more about the world of anime.
        </p>
        <a href="/articles/" class="primary-btn">Explore Articles</a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #0b0d17;
    color: #f5f5fa;
    font-family: Arial, Helvetica, sans-serif;
  }

  a {
    text-decoration: none;
  }

  .site-header {
    min-height: 76px;
    padding: 18px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    border-bottom: 1px solid #222638;
    background: #0b0d17;
  }

  .logo {
    color: white;
    font-size: 27px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .logo span {
    color: #9682ff;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
  }

  .site-header nav a {
    color: #b9bed0;
    font-size: 14px;
    transition: color 0.2s;
  }

  .site-header nav a:hover {
    color: #a895ff;
  }

  .hero {
    max-width: 1050px;
    margin: auto;
    padding: 115px 25px 105px;
    text-align: center;
  }

  .eyebrow {
    color: #a895ff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .hero h1 {
    max-width: 850px;
    margin: 22px auto;
    font-size: clamp(38px, 6vw, 65px);
    line-height: 1.12;
    font-weight: 800;
  }

  .hero h1 span {
    color: #a895ff;
  }

  .hero > p {
    max-width: 650px;
    margin: 0 auto;
    color: #aab0c3;
    font-size: 17px;
    line-height: 1.8;
  }

  .hero-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .primary-btn,
  .secondary-btn {
    display: inline-block;
    padding: 14px 23px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: 0.2s;
  }

  .primary-btn {
    color: white;
    background: #7963e8;
  }

  .primary-btn:hover {
    background: #907dff;
    transform: translateY(-2px);
  }

  .secondary-btn {
    color: white;
    border: 1px solid #45415f;
    background: #171827;
  }

  .secondary-btn:hover {
    border-color: #a895ff;
  }

  .tools-section {
    padding: 75px 7%;
    background: #101321;
  }

  .section-heading {
    margin-bottom: 38px;
    text-align: center;
  }

  .section-heading h2,
  .about-section h2,
  .articles-section h2 {
    margin: 15px 0;
    font-size: clamp(27px, 4vw, 36px);
  }

  .section-heading p,
  .articles-section p {
    color: #aab0c3;
    line-height: 1.7;
  }

  .tools-grid {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .tool-card {
    display: block;
    padding: 30px 25px;
    border: 1px solid #292d43;
    border-radius: 13px;
    background: #171a2a;
    transition: 0.25s;
  }

  .tool-card:hover {
    transform: translateY(-5px);
    border-color: #8875ed;
    background: #1c1d32;
  }

  .tool-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #292344;
    color: #b3a4ff;
    font-size: 27px;
  }

  .tool-card h3 {
    margin: 22px 0 12px;
    color: white;
    font-size: 21px;
  }

  .tool-card p {
    min-height: 80px;
    color: #aab0c3;
    font-size: 14px;
    line-height: 1.8;
  }

  .card-link {
    display: inline-block;
    margin-top: 15px;
    color: #aa99ff;
    font-size: 14px;
    font-weight: 700;
  }

  .about-section {
    max-width: 850px;
    margin: auto;
    padding: 90px 25px;
    text-align: center;
  }

  .about-section p {
    color: #aab0c3;
    font-size: 15px;
    line-height: 1.9;
  }

  .about-link {
    display: inline-block;
    margin-top: 15px;
    color: #aa99ff;
    font-weight: 700;
  }

  .articles-section {
    padding: 65px 20px 80px;
    text-align: center;
    background: #101321;
  }

  .articles-section p {
    max-width: 620px;
    margin: 0 auto 25px;
  }

  @media (max-width: 750px) {
    .site-header {
      flex-direction: column;
      padding: 18px;
    }

    .site-header nav {
      justify-content: center;
      gap: 15px;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tool-card p {
      min-height: auto;
    }

    .hero {
      padding: 80px 22px;
    }
  }
</style>
