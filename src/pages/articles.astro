
---
import Footer from "../components/Footer.astro";
import { getPublishedArticles } from "../lib/articles";

const articles = await getPublishedArticles();

const title = "Anime Articles & Guides | Bezels";
const description =
  "Explore anime guides, recommendations, explainers and useful information for anime fans at Bezels.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://bezels.site/articles/" />
    <title>{title}</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #090714;
        color: #f4f0ff;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 8%;
        border-bottom: 1px solid #292044;
      }

      .logo {
        font-size: 27px;
        font-weight: 800;
        color: white;
        text-decoration: none;
      }

      .logo span { color: #a58aff; }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
      }

      nav a {
        color: #c1b8d8;
        text-decoration: none;
        font-size: 14px;
      }

      nav a:hover,
      nav a.active { color: #b69cff; }

      .intro {
        max-width: 850px;
        margin: auto;
        padding: 85px 22px 45px;
        text-align: center;
      }

      .eyebrow {
        color: #b69cff;
        font-size: 12px;
        letter-spacing: 2px;
      }

      h1 {
        font-size: clamp(36px, 6vw, 55px);
        margin: 18px 0;
      }

      h1 span { color: #a58aff; }

      .intro p {
        color: #b8afcc;
        line-height: 1.8;
        font-size: 16px;
      }

      .articles {
        max-width: 1100px;
        margin: 0 auto 90px;
        padding: 0 22px;
      }

      .articles h2 {
        font-size: 25px;
        margin-bottom: 22px;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 22px;
        align-items: stretch;
      }

      .article-card {
        min-width: 0;
        overflow: hidden;
        background: linear-gradient(145deg, #17112b, #100d1e);
        border: 1px solid #38275e;
        border-radius: 16px;
        transition: transform 0.25s, border-color 0.25s;
      }

      .article-card:hover {
        transform: translateY(-5px);
        border-color: #a58aff;
      }

      /* Fixed image area for every article card */
      .article-image-wrap {
        width: 100%;
        height: 175px;
        overflow: hidden;
        background: #201638;
      }

      .article-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .article-content {
        padding: 23px;
      }

      .category {
        color: #b69cff;
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .article-card h3 {
        font-size: 19px;
        line-height: 1.5;
        margin: 13px 0;
      }

      .article-card p {
        color: #b8afcc;
        font-size: 14px;
        line-height: 1.8;
      }

      .article-date {
        display: block;
        color: #9187a8;
        font-size: 12px;
        margin-top: 15px;
      }

      .read-link {
        display: inline-block;
        margin-top: 18px;
        color: #c0aaff;
        font-size: 13px;
        font-weight: bold;
        text-decoration: none;
      }

      .read-link:hover { color: white; }

      .empty-state {
        padding: 45px 20px;
        text-align: center;
        background: #151025;
        border: 1px solid #38275e;
        border-radius: 16px;
        color: #b8afcc;
        line-height: 1.8;
      }

      @media (max-width: 650px) {
        header {
          padding: 20px;
          flex-direction: column;
          gap: 18px;
        }

        nav {
          justify-content: center;
          gap: 14px;
        }

        nav a { font-size: 12px; }
        .intro { padding-top: 55px; }

        .article-image-wrap {
          height: 190px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">BEZELS<span>.</span></a>
      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/" class="active">Articles</a>
      </nav>
    </header>

    <main>
      <section class="intro">
        <span class="eyebrow">THE BEZELS ANIME LIBRARY</span>
        <h1>Anime Articles & <span>Guides.</span></h1>
        <p>
          Explore anime recommendations, helpful guides,
          explanations and interesting topics from the
          world of anime.
        </p>
      </section>

      <section class="articles">
        <h2>Latest Articles</h2>

        {articles.length > 0 ? (
          <div class="article-grid">
            {articles.map((article) => (
              <article class="article-card">
                {article.featured_image && (
                  <div class="article-image-wrap">
                    <img
                      class="article-image"
                      src={article.featured_image}
                      alt={article.title}
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="article-content">
                  <span class="category">
                    {article.category || "Anime Guide"}
                  </span>

                  <h3>{article.title}</h3>

                  <p>
                    {article.excerpt || "Explore this anime article on Bezels."}
                  </p>

                  {article.published_at && (
                    <time class="article-date" datetime={article.published_at}>
                      {new Date(article.published_at).toLocaleDateString("en", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                        timeZone: "UTC"
                      })}
                    </time>
                  )}

                  <a
                    class="read-link"
                    href={`/articles/${article.slug}/`}
                  >
                    Read Article →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h3>No published articles yet</h3>
            <p>
              New anime guides and articles will appear here
              once they are published.
            </p>
          </div>
        )}
      </section>
    </main>

    <Footer />
  </body>
</html>
