
---
import Footer from "../components/Footer.astro";
import { getPublishedArticles } from "../lib/articles";

const articles = await getPublishedArticles();

const title = "Anime Articles & Guides | Bezels";
const description =
  "Explore anime guides, recommendations, explainers and useful information for anime fans at Bezels.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://bezels.site/articles/" />
    <title>{title}</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #090714;
        color: #f4f0ff;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 8%;
        border-bottom: 1px solid #292044;
      }

      .logo {
        font-size: 27px;
        font-weight: 800;
        color: white;
        text-decoration: none;
      }

      .logo span { color: #a58aff; }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
      }

      nav a {
        color: #c1b8d8;
        text-decoration: none;
        font-size: 14px;
      }

      nav a:hover,
      nav a.active { color: #b69cff; }

      .intro {
        max-width: 850px;
        margin: auto;
        padding: 85px 22px 45px;
        text-align: center;
      }

      .eyebrow {
        color: #b69cff;
        font-size: 12px;
        letter-spacing: 2px;
      }

      h1 {
        font-size: clamp(36px, 6vw, 55px);
        margin: 18px 0;
      }

      h1 span { color: #a58aff; }

      .intro p {
        color: #b8afcc;
        line-height: 1.8;
        font-size: 16px;
      }

      .articles {
        max-width: 1100px;
        margin: 0 auto 90px;
        padding: 0 22px;
      }

      .articles h2 {
        font-size: 25px;
        margin-bottom: 22px;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 22px;
        align-items: stretch;
      }

      .article-card {
        min-width: 0;
        overflow: hidden;
        background: linear-gradient(145deg, #17112b, #100d1e);
        border: 1px solid #38275e;
        border-radius: 16px;
        transition: transform 0.25s, border-color 0.25s;
      }

      .article-card:hover {
        transform: translateY(-5px);
        border-color: #a58aff;
      }

      .article-image-wrap {
        width: 100%;
        height: 175px;
        overflow: hidden;
        background: #201638;
      }

      .article-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .article-content {
        padding: 23px;
      }

      .category {
        color: #b69cff;
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .article-card h3 {
        font-size: 19px;
        line-height: 1.5;
        margin: 13px 0;
      }

      .article-card p {
        color: #b8afcc;
        font-size: 14px;
        line-height: 1.8;
      }

      .article-date {
        display: block;
        color: #9187a8;
        font-size: 12px;
        margin-top: 15px;
      }

      .read-link {
        display: inline-block;
        margin-top: 18px;
        color: #c0aaff;
        font-size: 13px;
        font-weight: bold;
        text-decoration: none;
      }

      .read-link:hover { color: white; }

      .empty-state {
        padding: 45px 20px;
        text-align: center;
        background: #151025;
        border: 1px solid #38275e;
        border-radius: 16px;
        color: #b8afcc;
        line-height: 1.8;
      }

      /* Pagination */
      .pagination {
        display: none;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 42px;
      }

      .pagination button {
        min-width: 42px;
        height: 42px;
        padding: 0 13px;
        border: 1px solid #38275e;
        border-radius: 9px;
        background: #17112b;
        color: #d8cafa;
        font-size: 14px;
        cursor: pointer;
        transition: 0.2s;
      }

      .pagination button:hover:not(:disabled) {
        border-color: #a58aff;
        color: white;
      }

      .pagination button.active {
        background: #8b68df;
        border-color: #a58aff;
        color: white;
      }

      .pagination button:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .pagination-info {
        text-align: center;
        color: #9187a8;
        font-size: 12px;
        margin-top: 15px;
      }

      @media (max-width: 650px) {
        header {
          padding: 20px;
          flex-direction: column;
          gap: 18px;
        }

        nav {
          justify-content: center;
          gap: 14px;
        }

        nav a { font-size: 12px; }
        .intro { padding-top: 55px; }

        .article-image-wrap {
          height: 190px;
        }

        .pagination {
          gap: 6px;
        }

        .pagination button {
          min-width: 37px;
          height: 38px;
          padding: 0 9px;
          font-size: 13px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">BEZELS<span>.</span></a>
      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/" class="active">Articles</a>
      </nav>
    </header>

    <main>
      <section class="intro">
        <span class="eyebrow">THE BEZELS ANIME LIBRARY</span>
        <h1>Anime Articles & <span>Guides.</span></h1>
        <p>
          Explore anime recommendations, helpful guides,
          explanations and interesting topics from the
          world of anime.
        </p>
      </section>

      <section class="articles">
        <h2>Latest Articles</h2>

        {articles.length > 0 ? (
          <>
            <div class="article-grid" id="article-grid">
              {articles.map((article) => (
                <article class="article-card">
                  {article.featured_image && (
                    <div class="article-image-wrap">
                      <img
                        class="article-image"
                        src={article.featured_image}
                        alt={article.title}
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="article-content">
                    <span class="category">
                      {article.category || "Anime Guide"}
                    </span>

                    <h3>{article.title}</h3>

                    <p>
                      {article.excerpt || "Explore this anime article on Bezels."}
                    </p>

                    {article.published_at && (
                      <time class="article-date" datetime={article.published_at}>
                        {new Date(article.published_at).toLocaleDateString("en", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                          timeZone: "UTC"
                        })}
                      </time>
                    )}

                    <a
                      class="read-link"
                      href={`/articles/${article.slug}/`}
                    >
                      Read Article →
                    </a>
                  </div>
                </article>
              ))}
            </div>

            <div
              class="pagination"
              id="pagination"
              aria-label="Article pagination"
            ></div>

            <p class="pagination-info" id="pagination-info"></p>
          </>
        ) : (
          <div class="empty-state">
            <h3>No published articles yet</h3>
            <p>
              New anime guides and articles will appear here
              once they are published.
            </p>
          </div>
        )}
      </section>
    </main>

    <Footer />

    <script>
      const articlesPerPage = 9;
      const articleGrid = document.getElementById("article-grid");
      const pagination = document.getElementById("pagination");
      const paginationInfo = document.getElementById("pagination-info");

      if (articleGrid && pagination && paginationInfo) {
        const cards = Array.from(
          articleGrid.querySelectorAll(".article-card")
        );

        const totalPages = Math.ceil(cards.length / articlesPerPage);

        function renderPage(page, updateUrl = true) {
          const currentPage = Math.min(
            Math.max(1, page),
            Math.max(1, totalPages)
          );

          const start = (currentPage - 1) * articlesPerPage;
          const end = start + articlesPerPage;

          cards.forEach((card, index) => {
            card.style.display =
              index >= start && index < end ? "" : "none";
          });

          if (totalPages <= 1) {
            pagination.style.display = "none";
            paginationInfo.textContent = "";
          } else {
            pagination.style.display = "flex";
            pagination.innerHTML = "";

            const previousButton = document.createElement("button");
            previousButton.textContent = "Previous";
            previousButton.disabled = currentPage === 1;
            previousButton.addEventListener("click", () => {
              renderPage(currentPage - 1);
            });
            pagination.appendChild(previousButton);

            for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
              const button = document.createElement("button");
              button.textContent = String(pageNumber);

              if (pageNumber === currentPage) {
                button.classList.add("active");
                button.setAttribute("aria-current", "page");
              }

              button.addEventListener("click", () => {
                renderPage(pageNumber);
              });

              pagination.appendChild(button);
            }

            const nextButton = document.createElement("button");
            nextButton.textContent = "Next";
            nextButton.disabled = currentPage === totalPages;
            nextButton.addEventListener("click", () => {
              renderPage(currentPage + 1);
            });
            pagination.appendChild(nextButton);

            paginationInfo.textContent =
              `Showing ${start + 1}–${Math.min(end, cards.length)} of ${cards.length} articles`;
          }

          if (updateUrl) {
            const url = new URL(window.location.href);

            if (currentPage === 1) {
              url.searchParams.delete("page");
            } else {
              url.searchParams.set("page", String(currentPage));
            }

            window.history.pushState({}, "", url);
          }

          window.scrollTo({
            top: document.querySelector(".articles").offsetTop - 25,
            behavior: "smooth"
          });
        }

        const requestedPage = Number(
          new URLSearchParams(window.location.search).get("page")
        ) || 1;

        renderPage(requestedPage, false);

        window.addEventListener("popstate", () => {
          const page = Number(
            new URLSearchParams(window.location.search).get("page")
          ) || 1;

          renderPage(page, false);
        });
      }
    </script>
  </body>
</html>
