
---
import Footer from "../components/Footer.astro";

const title = "Anime Articles & Guides | Bezels";
const description =
  "Explore anime guides, recommendations, explainers and useful information for anime fans at Bezels.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #090d18;
        color: #f4f6ff;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 8%;
        border-bottom: 1px solid #20283b;
      }

      .logo {
        font-size: 27px;
        font-weight: 800;
        color: white;
        text-decoration: none;
      }

      .logo span { color: #8b7cff; }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
      }

      nav a {
        color: #b9bfd1;
        text-decoration: none;
        font-size: 14px;
      }

      nav a:hover,
      nav a.active { color: #a99aff; }

      .intro {
        max-width: 850px;
        margin: auto;
        padding: 85px 22px 45px;
        text-align: center;
      }

      .eyebrow {
        color: #a99aff;
        font-size: 12px;
        letter-spacing: 2px;
      }

      h1 {
        font-size: clamp(36px, 6vw, 55px);
        margin: 18px 0;
      }

      h1 span { color: #9685ff; }

      .intro p {
        color: #aab2c6;
        line-height: 1.8;
        font-size: 16px;
      }

      .articles {
        max-width: 1050px;
        margin: 0 auto 90px;
        padding: 0 22px;
      }

      .articles h2 {
        font-size: 25px;
        margin-bottom: 22px;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
      }

      .article-card {
        background: #111a2c;
        border: 1px solid #293650;
        border-radius: 14px;
        padding: 25px;
      }

      .article-card span {
        color: #a99aff;
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .article-card h3 {
        font-size: 19px;
        line-height: 1.5;
        margin: 13px 0;
      }

      .article-card p {
        color: #aab2c6;
        font-size: 14px;
        line-height: 1.8;
      }

      .coming-soon {
        display: inline-block;
        margin-top: 18px;
        color: #b9aaff;
        font-size: 12px;
      }

      @media (max-width: 650px) {
        header {
          padding: 20px;
          flex-direction: column;
          gap: 18px;
        }

        nav {
          justify-content: center;
          gap: 14px;
        }

        nav a { font-size: 12px; }
        .intro { padding-top: 55px; }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">BEZELS<span>.</span></a>
      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/" class="active">Articles</a>
      </nav>
    </header>

    <main>
      <section class="intro">
        <span class="eyebrow">THE BEZELS ANIME LIBRARY</span>
        <h1>Anime Articles & <span>Guides.</span></h1>
        <p>
          Explore anime recommendations, helpful guides,
          explanations and interesting topics from the
          world of anime.
        </p>
      </section>

      <section class="articles">
        <h2>Explore Our Topics</h2>

        <div class="article-grid">
          <article class="article-card">
            <span>Anime Discovery</span>
            <h3>How to Find Anime That Matches Your Interests</h3>
            <p>
              Learn how genres, moods and storytelling preferences
              can help you discover your next anime.
            </p>
            <a class="coming-soon" href="/find-anime/">Explore Anime Finder →</a>
          </article>

          <article class="article-card">
            <span>Anime Quiz</span>
            <h3>How Anime Recommendation Quizzes Work</h3>
            <p>
              Understand how your viewing preferences can be used
              to find anime worth exploring.
            </p>
            <a class="coming-soon" href="/anime-quiz/">Try the Anime Quiz →</a>
          </article>

          <article class="article-card">
            <span>Watchlist Guides</span>
            <h3>Why Every Anime Fan Can Benefit From a Watchlist</h3>
            <p>
              Discover simple ways to organise anime you plan
              to watch and series you have completed.
            </p>
            <a class="coming-soon" href="/watchlist/">Open Your Watchlist →</a>
          </article>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
