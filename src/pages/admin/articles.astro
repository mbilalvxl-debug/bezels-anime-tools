
---
import ArticleEditor from "../../components/ArticleEditor.astro";

const title = "Article Manager | Bezels";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
</head>

<body>
  <div class="admin-layout">
    <aside class="sidebar">
      <a href="/" class="brand">BEZELS<span>.</span></a>

      <div class="sidebar-label">MAIN MENU</div>
      <a href="/admin/dashboard/" class="nav-link">▦ Dashboard</a>

      <div class="sidebar-label">CONTENT</div>
      <a href="/admin/anime/" class="nav-link">◈ Anime Manager</a>
      <a href="/admin/articles/" class="nav-link active">▤ Article Manager</a>

      <div class="sidebar-bottom">
        <a href="/" class="website-link">↗ Visit Website</a>
        <button id="logout-button" class="logout-button">↪ Logout</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <div class="eyebrow">BEZELS CONTROL PANEL</div>
          <h1>Article Manager</h1>
          <p class="subtitle">Create and manage your anime articles.</p>
        </div>
        <a href="/admin/dashboard/" class="back-link">← Dashboard</a>
      </header>

      <div id="page-message" class="message" role="status" aria-live="polite">
        Verifying admin access...
      </div>

      <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

      <section class="editor-panel">
        <div class="panel-heading">
          <div>
            <h2 id="form-heading">Create New Article</h2>
            <p>Write, format and manage your article content.</p>
          </div>
          <span class="panel-icon">✦</span>
        </div>

        <form id="article-form">
          <div class="form-grid">
            <div class="field full">
              <label for="article-title">Article Title *</label>
              <input id="article-title" type="text" required placeholder="Enter article title" />
            </div>

            <div class="field">
              <label for="article-slug">URL Slug *</label>
              <input id="article-slug" type="text" required placeholder="your-article-url" />
              <small>Example: black-butler-netflix-return</small>
            </div>

            <div class="field">
              <label for="article-category">Category</label>
              <input id="article-category" type="text" placeholder="Anime News, Reviews..." />
            </div>

            <div class="field full">
              <label for="article-excerpt">Article Excerpt</label>
              <textarea id="article-excerpt" rows="3" placeholder="A short introduction to your article..."></textarea>
            </div>

            <div class="field full">
              <label for="article-image">Featured Image URL</label>
              <input id="article-image" type="url" placeholder="https://example.com/image.jpg" />
            </div>

            <div class="field full">
              <label>Article Content *</label>
              <ArticleEditor />
            </div>

            <div class="field full">
              <label for="article-tags">Tags</label>
              <input id="article-tags" type="text" placeholder="Anime, News, Netflix, Black Butler" />
              <small>Separate tags with commas.</small>
            </div>
          </div>

          <div class="seo-section">
            <h3>SEO Settings</h3>

            <div class="field">
              <label for="seo-title">SEO Title</label>
              <input id="seo-title" type="text" maxlength="70" placeholder="SEO title for search engines" />
            </div>

            <div class="field">
              <label for="meta-description">Meta Description</label>
              <textarea id="meta-description" rows="3" maxlength="170" placeholder="Write a search-friendly description..."></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" id="cancel-edit" class="secondary-button" hidden>Cancel Edit</button>
            <button type="submit" id="draft-button" class="secondary-button">Save Draft</button>
            <button type="submit" id="publish-button" class="primary-button">Publish Article</button>
          </div>
        </form>
      </section>

      <section class="articles-panel">
        <div class="panel-heading">
          <div>
            <h2>Your Articles</h2>
            <p>View, edit and delete saved articles.</p>
          </div>
          <span id="article-total" class="total-count">0 Articles</span>
        </div>

        <div class="article-toolbar">
          <input
            id="article-search"
            class="article-search"
            type="search"
            placeholder="Search by title..."
            aria-label="Search articles by title"
          />
          <span id="article-range" class="article-range">Loading articles...</span>
        </div>

        <div id="article-list" class="article-list">
          <p class="empty-state">Loading articles...</p>
        </div>

        <nav id="pagination" class="pagination" aria-label="Article pages" hidden>
          <button type="button" id="previous-page" class="page-button">← Previous</button>
          <div id="page-numbers" class="page-numbers"></div>
          <button type="button" id="next-page" class="page-button">Next →</button>
        </nav>
      </section>
    </main>
  </div>
</body>
</html>

<script>
  import { supabase } from "../../lib/supabase";

  type ArticleRecord = {
    id: string;
    title: string;
    slug: string;
    category: string | null;
    status: string;
    published_at: string | null;
    created_at: string;
  };

  const PAGE_SIZE = 10;

  const message = document.querySelector<HTMLElement>("#page-message");
  const toastContainer = document.querySelector<HTMLElement>("#toast-container");
  const form = document.querySelector<HTMLFormElement>("#article-form");
  const articleList = document.querySelector<HTMLElement>("#article-list");
  const articleTotal = document.querySelector<HTMLElement>("#article-total");
  const articleRange = document.querySelector<HTMLElement>("#article-range");
  const articleSearch = document.querySelector<HTMLInputElement>("#article-search");
  const pagination = document.querySelector<HTMLElement>("#pagination");
  const pageNumbers = document.querySelector<HTMLElement>("#page-numbers");
  const previousPageButton = document.querySelector<HTMLButtonElement>("#previous-page");
  const nextPageButton = document.querySelector<HTMLButtonElement>("#next-page");
  const formHeading = document.querySelector<HTMLElement>("#form-heading");

  const titleInput = document.querySelector<HTMLInputElement>("#article-title");
  const slugInput = document.querySelector<HTMLInputElement>("#article-slug");
  const categoryInput = document.querySelector<HTMLInputElement>("#article-category");
  const excerptInput = document.querySelector<HTMLTextAreaElement>("#article-excerpt");
  const imageInput = document.querySelector<HTMLInputElement>("#article-image");
  const tagsInput = document.querySelector<HTMLInputElement>("#article-tags");
  const seoTitleInput = document.querySelector<HTMLInputElement>("#seo-title");
  const metaDescriptionInput = document.querySelector<HTMLTextAreaElement>("#meta-description");
  const contentInput = document.querySelector<HTMLInputElement>("#article-editor-json");

  const draftButton = document.querySelector<HTMLButtonElement>("#draft-button");
  const publishButton = document.querySelector<HTMLButtonElement>("#publish-button");
  const cancelButton = document.querySelector<HTMLButtonElement>("#cancel-edit");
  const logoutButton = document.querySelector<HTMLButtonElement>("#logout-button");

  let editingId: string | null = null;
  let editingOriginalStatus: string | null = null;
  let isAdmin = false;
  let currentPage = 1;
  let totalArticles = 0;
  let totalPages = 1;
  let currentArticles: ArticleRecord[] = [];
  let searchTimer: ReturnType<typeof setTimeout> | undefined;

  let toastCounter = 0;

  // Floating notification system.
  function showToast(text: string, type: "success" | "error" | "info" = "info") {
    if (!toastContainer) return;

    toastCounter += 1;

    const toast = document.createElement("div");
    toast.className = `toast toast-${type}`;
    toast.setAttribute("role", type === "error" ? "alert" : "status");

    const icons = {
      success: "✓",
      error: "!",
      info: "i",
    };

    const headings = {
      success: "Success",
      error: "Something went wrong",
      info: "Please wait",
    };

    const icon = document.createElement("span");
    icon.className = "toast-icon";
    icon.textContent = icons[type];

    const content = document.createElement("div");
    content.className = "toast-content";

    const heading = document.createElement("strong");
    heading.textContent = headings[type];

    const description = document.createElement("span");
    description.textContent = text;

    content.append(heading, description);

    const closeButton = document.createElement("button");
    closeButton.type = "button";
    closeButton.className = "toast-close";
    closeButton.setAttribute("aria-label", "Dismiss notification");
    closeButton.textContent = "×";

    toast.append(icon, content, closeButton);
    toastContainer.appendChild(toast);

    let dismissed = false;

    const dismiss = () => {
      if (dismissed) return;
      dismissed = true;
      toast.classList.add("toast-leaving");
      window.setTimeout(() => toast.remove(), 250);
    };

    closeButton.addEventListener("click", dismiss);

    const duration = type === "error" ? 6500 : 4500;
    const timer = window.setTimeout(dismiss, duration);

    toast.addEventListener("mouseenter", () => {
      window.clearTimeout(timer);
    });

    toast.addEventListener("mouseleave", () => {
      if (!dismissed) {
        window.setTimeout(dismiss, 1200);
      }
    });

    // Keep the newest notifications visible.
    while (toastContainer.children.length > 4) {
      toastContainer.firstElementChild?.remove();
    }
  }

  function showMessage(text: string, type = "info") {
    if (message) {
      message.textContent = text;
      message.className = `message ${type}`;
    }

    // Keep the persistent admin verification message quiet.
    // Action results are shown as floating notifications instead.
    if (type !== "info" || !text.startsWith("Admin verified:")) {
      showToast(
        text,
        type === "success" ? "success" : type === "error" ? "error" : "info"
      );
    }
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;",
    })[char] ?? char);
  }

  function makeSlug(value: string): string {
    return value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  async function triggerWebsiteDeployment(): Promise<void> {
    const { data, error } = await supabase.functions.invoke(
      "trigger-cloudflare-deploy",
      { body: {} }
    );

    if (error) {
      throw new Error(error.message || "Could not trigger website deployment.");
    }

    if (!data?.success) {
      throw new Error(data?.error || "Deployment trigger was not confirmed.");
    }
  }

  titleInput?.addEventListener("input", () => {
    if (!editingId && slugInput && !slugInput.dataset.manuallyEdited) {
      slugInput.value = makeSlug(titleInput.value);
    }
  });

  slugInput?.addEventListener("input", () => {
    if (slugInput) slugInput.dataset.manuallyEdited = "true";
  });

  function resetForm() {
    form?.reset();
    editingId = null;
    editingOriginalStatus = null;

    if (formHeading) formHeading.textContent = "Create New Article";
    if (draftButton) draftButton.textContent = "Save Draft";
    if (publishButton) publishButton.textContent = "Publish Article";
    if (cancelButton) cancelButton.hidden = true;

    if (slugInput) slugInput.dataset.manuallyEdited = "";

    window.dispatchEvent(
      new CustomEvent("bezels-set-article-content", {
        detail: "<p>Start writing your article here...</p>",
      })
    );
  }

  function renderArticles(articles: ArticleRecord[]) {
    if (!articleList) return;

    currentArticles = articles;

    if (articles.length === 0) {
      articleList.innerHTML = '<p class="empty-state">No articles found. Create your first article above.</p>';
      return;
    }

    articleList.innerHTML = articles.map((article) => {
      const statusClass = article.status === "published" ? "published" : "draft";
      const date = article.published_at || article.created_at;
      const formattedDate = date
        ? new Date(date).toLocaleDateString()
        : "Date unavailable";

      return `
        <div class="article-row">
          <div class="article-info">
            <h3>${escapeHtml(article.title)}</h3>
            <p>/${escapeHtml(article.slug)}/</p>
            <div class="article-meta">
              <span class="status-label ${statusClass}">${escapeHtml(article.status)}</span>
              <span>${escapeHtml(article.category || "Uncategorized")}</span>
              <span>${escapeHtml(formattedDate)}</span>
            </div>
          </div>
          <div class="article-actions">
            <button type="button" class="edit-button" data-edit="${escapeHtml(article.id)}">Edit</button>
            <button type="button" class="delete-button" data-delete="${escapeHtml(article.id)}">Delete</button>
          </div>
        </div>
      `;
    }).join("");
  }

  function renderPagination() {
    if (!pagination || !pageNumbers || !previousPageButton || !nextPageButton || !articleRange) return;

    totalPages = Math.max(1, Math.ceil(totalArticles / PAGE_SIZE));

    const firstItem = totalArticles === 0 ? 0 : (currentPage - 1) * PAGE_SIZE + 1;
    const lastItem = Math.min(currentPage * PAGE_SIZE, totalArticles);

    articleRange.textContent = totalArticles === 0
      ? "No articles to display"
      : `Showing ${firstItem}–${lastItem} of ${totalArticles} articles`;

    pagination.hidden = totalPages <= 1;
    previousPageButton.disabled = currentPage <= 1;
    nextPageButton.disabled = currentPage >= totalPages;

    const pages = new Set<number>();
    pages.add(1);
    pages.add(totalPages);

    for (let page = Math.max(1, currentPage - 2); page <= Math.min(totalPages, currentPage + 2); page++) {
      pages.add(page);
    }

    const sortedPages = [...pages].sort((a, b) => a - b);
    let html = "";
    let previous = 0;

    for (const page of sortedPages) {
      if (previous && page - previous > 1) {
        html += '<span class="page-ellipsis">…</span>';
      }

      html += `
        <button
          type="button"
          class="page-number ${page === currentPage ? "active" : ""}"
          data-page="${page}"
          ${page === currentPage ? 'aria-current="page"' : ""}
        >${page}</button>
      `;

      previous = page;
    }

    pageNumbers.innerHTML = html;
  }

  async function loadArticles() {
    if (!isAdmin || !articleList) return;

    articleList.innerHTML = '<p class="empty-state">Loading articles...</p>';
    if (articleRange) articleRange.textContent = "Loading articles...";

    const from = (currentPage - 1) * PAGE_SIZE;
    const to = from + PAGE_SIZE - 1;
    const searchTerm = articleSearch?.value.trim() ?? "";

    let query = supabase
      .from("articles")
      .select("*", { count: "exact" });

    if (searchTerm) {
      query = query.ilike("title", `%${searchTerm}%`);
    }

    const { data, error, count } = await query
      .order("created_at", { ascending: false })
      .range(from, to);

    if (error) {
      showMessage(`Could not load articles: ${error.message}`, "error");
      articleList.innerHTML = '<p class="empty-state">Articles could not be loaded.</p>';
      if (articleRange) articleRange.textContent = "Unable to load articles";
      return;
    }

    totalArticles = count ?? 0;
    totalPages = Math.max(1, Math.ceil(totalArticles / PAGE_SIZE));

    if (currentPage > totalPages) {
      currentPage = totalPages;
      await loadArticles();
      return;
    }

    renderArticles((data ?? []) as ArticleRecord[]);

    if (articleTotal) {
      articleTotal.textContent = `${totalArticles} Article${totalArticles === 1 ? "" : "s"}`;
    }

    renderPagination();
  }

  async function verifyAdmin() {
    const { data: sessionData, error: sessionError } =
      await supabase.auth.getSession();

    const user = sessionData.session?.user;

    if (sessionError || !user) {
      window.location.replace("/admin/login/");
      return;
    }

    const { data: admin, error: adminError } = await supabase
      .from("admin_users")
      .select("user_id")
      .eq("user_id", user.id)
      .maybeSingle();

    if (adminError || !admin) {
      await supabase.auth.signOut();
      window.location.replace("/admin/login/");
      return;
    }

    isAdmin = true;
    if (message) {
      message.textContent = `Admin verified: ${user.email}`;
      message.className = "message success";
    }

    await loadArticles();
  }

  async function saveArticle(status: "draft" | "published") {
    if (!isAdmin) return;

    const title = titleInput?.value.trim() ?? "";
    const slug = makeSlug(slugInput?.value ?? "");
    const rawContent = contentInput?.value ?? "";

    if (!title || !slug) {
      showMessage("Please enter an article title and URL slug.", "error");
      return;
    }

    let content;

    try {
      content = JSON.parse(rawContent);
    } catch {
      showMessage("Article content could not be read. Please try again.", "error");
      return;
    }

    const now = new Date().toISOString();

    const record = {
      title,
      slug,
      excerpt: excerptInput?.value.trim() || null,
      content,
      featured_image: imageInput?.value.trim() || null,
      category: categoryInput?.value.trim() || null,
      tags: (tagsInput?.value ?? "")
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean),
      seo_title: seoTitleInput?.value.trim() || null,
      meta_description: metaDescriptionInput?.value.trim() || null,
      status,
      published_at: status === "published" ? now : null,
    };

    const activeButton = status === "draft" ? draftButton : publishButton;

    if (draftButton) draftButton.disabled = true;
    if (publishButton) publishButton.disabled = true;
    if (activeButton) activeButton.textContent = "Saving...";

    try {
      const shouldDeploy =
        status === "published" || editingOriginalStatus === "published";

      const result = editingId
        ? await supabase.from("articles").update(record).eq("id", editingId)
        : await supabase.from("articles").insert(record);

      if (result.error) throw result.error;

      const wasEditing = Boolean(editingId);

      resetForm();

      if (!wasEditing) currentPage = 1;
      await loadArticles();

      if (shouldDeploy) {
        showMessage("Article saved. Triggering website update...", "info");

        try {
          await triggerWebsiteDeployment();

          showMessage(
            status === "published"
              ? "Article published/saved! Website rebuild has been triggered."
              : "Article unpublished successfully! Website rebuild has been triggered.",
            "success"
          );
        } catch (deployError) {
          showMessage(
            `Article was saved, but website deployment could not be triggered: ${deployError instanceof Error ? deployError.message : "Unknown error"}`,
            "error"
          );
        }
      } else {
        showMessage("Draft saved successfully!", "success");
      }
    } catch (error) {
      showMessage(
        `Save failed: ${error instanceof Error ? error.message : "Unknown error"}`,
        "error"
      );
    } finally {
      if (draftButton) {
        draftButton.disabled = false;
        draftButton.textContent = editingId ? "Update Draft" : "Save Draft";
      }
      if (publishButton) {
        publishButton.disabled = false;
        publishButton.textContent = editingId ? "Update & Publish" : "Publish Article";
      }
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
    const status = submitter?.id === "draft-button" ? "draft" : "published";

    await saveArticle(status);
  });

  cancelButton?.addEventListener("click", () => {
    resetForm();
    showMessage("Editing cancelled.", "info");
  });

  articleList?.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    const editButton = target.closest<HTMLButtonElement>("[data-edit]");
    const deleteButton = target.closest<HTMLButtonElement>("[data-delete]");

    if (editButton) {
      const id = editButton.dataset.edit;
      if (!id) return;

      const { data: article, error } = await supabase
        .from("articles")
        .select("*")
        .eq("id", id)
        .single();

      if (error || !article) {
        showMessage("Could not load this article for editing.", "error");
        return;
      }

      editingId = article.id;
      editingOriginalStatus = article.status;

      if (titleInput) titleInput.value = article.title ?? "";
      if (slugInput) {
        slugInput.value = article.slug ?? "";
        slugInput.dataset.manuallyEdited = "true";
      }
      if (categoryInput) categoryInput.value = article.category ?? "";
      if (excerptInput) excerptInput.value = article.excerpt ?? "";
      if (imageInput) imageInput.value = article.featured_image ?? "";
      if (tagsInput) tagsInput.value = (article.tags ?? []).join(", ");
      if (seoTitleInput) seoTitleInput.value = article.seo_title ?? "";
      if (metaDescriptionInput) metaDescriptionInput.value = article.meta_description ?? "";

      window.dispatchEvent(
        new CustomEvent("bezels-set-article-content", {
          detail: article.content,
        })
      );

      if (formHeading) formHeading.textContent = "Edit Article";
      if (draftButton) draftButton.textContent = "Update Draft";
      if (publishButton) publishButton.textContent = "Update & Publish";
      if (cancelButton) cancelButton.hidden = false;

      window.scrollTo({ top: 0, behavior: "smooth" });
      showMessage(`Editing: ${article.title}`, "info");
    }

    if (deleteButton) {
      const id = deleteButton.dataset.delete;
      if (!id) return;

      const confirmed = window.confirm("Are you sure you want to delete this article?");
      if (!confirmed) return;

      const articleBeingDeleted = currentArticles.find(
        (article) => article.id === id
      );

      const wasPublished = articleBeingDeleted?.status === "published";

      deleteButton.disabled = true;
      deleteButton.textContent = "Deleting...";

      const { error } = await supabase
        .from("articles")
        .delete()
        .eq("id", id);

      if (error) {
        showMessage(`Delete failed: ${error.message}`, "error");
        deleteButton.disabled = false;
        deleteButton.textContent = "Delete";
        return;
      }

      if (editingId === id) resetForm();

      await loadArticles();

      if (wasPublished) {
        showMessage("Published article deleted. Triggering website update...", "info");

        try {
          await triggerWebsiteDeployment();

          showMessage(
            "Article deleted successfully! Website rebuild has been triggered.",
            "success"
          );
        } catch (deployError) {
          showMessage(
            `Article deleted, but website deployment could not be triggered: ${deployError instanceof Error ? deployError.message : "Unknown error"}`,
            "error"
          );
        }
      } else {
        showMessage("Article deleted successfully.", "success");
      }
    }
  });

  articleSearch?.addEventListener("input", () => {
    if (searchTimer) clearTimeout(searchTimer);

    searchTimer = setTimeout(() => {
      currentPage = 1;
      void loadArticles();
    }, 300);
  });

  previousPageButton?.addEventListener("click", () => {
    if (currentPage <= 1) return;
    currentPage -= 1;
    void loadArticles();
  });

  nextPageButton?.addEventListener("click", () => {
    if (currentPage >= totalPages) return;
    currentPage += 1;
    void loadArticles();
  });

  pageNumbers?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>("[data-page]");
    const page = Number(button?.dataset.page);

    if (!Number.isInteger(page) || page < 1 || page > totalPages || page === currentPage) return;

    currentPage = page;
    void loadArticles();
  });

  logoutButton?.addEventListener("click", async () => {
    if (!logoutButton) return;

    logoutButton.disabled = true;
    logoutButton.textContent = "Signing out...";

    const { error } = await supabase.auth.signOut();

    if (error) {
      showMessage("Logout failed. Please try again.", "error");
      logoutButton.disabled = false;
      logoutButton.textContent = "↪ Logout";
      return;
    }

    window.location.replace("/admin/login/");
  });

  verifyAdmin();
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #0b0713;
    color: #f7f1ff;
    font-family: Arial, sans-serif;
  }

  .admin-layout {
    min-height: 100vh;
    display: flex;
  }

  .sidebar {
    width: 250px;
    min-height: 100vh;
    padding: 30px 18px;
    display: flex;
    flex-direction: column;
    background: #100b1b;
    border-right: 1px solid #2c1d40;
    flex-shrink: 0;
  }

  .brand {
    margin: 0 0 48px 10px;
    color: #fff;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 3px;
    text-decoration: none;
  }

  .brand span {
    color: #bd83ff;
  }

  .sidebar-label {
