
---
const title = "Admin Dashboard | Bezels";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
</head>

<body>
  <div class="admin-layout">
    <aside class="sidebar">
      <a href="/" class="brand">BEZELS<span>.</span></a>

      <div class="sidebar-label">MAIN MENU</div>

      <a href="/admin/dashboard/" class="nav-link active">
        <span>▦</span> Dashboard
      </a>

      <div class="sidebar-label">CONTENT</div>

      <a href="/admin/anime/" class="nav-link">
        <span>◈</span> Anime Manager
      </a>

      <a href="/admin/articles/" class="nav-link">
        <span>▤</span> Article Manager
      </a>

      <div class="sidebar-bottom">
        <a href="/" class="website-link">↗ Visit Website</a>
        <button id="logout-button" class="logout-button">↪ Logout</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div>
          <div class="eyebrow">BEZELS CONTROL PANEL</div>
          <h1>Dashboard</h1>
        </div>
        <div class="admin-badge">
          <span class="online-dot"></span>
          Admin Access
        </div>
      </header>

      <section class="welcome-panel">
        <div>
          <div class="welcome-tag">WELCOME BACK</div>
          <h2>Manage your Bezels website.</h2>
          <p>Everything you need to manage your anime database and editorial content will be available here.</p>
        </div>
        <div class="welcome-icon">✦</div>
      </section>

      <section class="stats-grid">
        <div class="stat-card">
          <div class="stat-top">
            <span>Total Anime</span>
            <span class="stat-icon">◈</span>
          </div>
          <div class="stat-number" id="anime-count">—</div>
          <div class="stat-description">Anime in your database</div>
        </div>

        <div class="stat-card">
          <div class="stat-top">
            <span>Total Articles</span>
            <span class="stat-icon">▤</span>
          </div>
          <div class="stat-number" id="article-count">—</div>
          <div class="stat-description">All saved articles</div>
        </div>

        <div class="stat-card">
          <div class="stat-top">
            <span>Published</span>
            <span class="stat-icon">✓</span>
          </div>
          <div class="stat-number" id="published-count">—</div>
          <div class="stat-description">Published articles</div>
        </div>
      </section>

      <section class="content-section">
        <div class="section-heading">
          <div>
            <h2>Content Management</h2>
            <p>Manage the content of your anime platform.</p>
          </div>
        </div>

        <div class="management-grid">
          <a href="/admin/anime/" class="management-card">
            <div class="management-icon">◈</div>
            <h3>Anime Manager</h3>
            <p>Add new anime, update existing information, manage genres and poster images.</p>
            <span class="open-label">Open Anime Manager →</span>
          </a>

          <a href="/admin/articles/" class="management-card">
            <div class="management-icon">▤</div>
            <h3>Article Manager</h3>
            <p>Create SEO-friendly articles, format headings and paragraphs, and publish content.</p>
            <span class="open-label">Open Article Manager →</span>
          </a>
        </div>
      </section>

      <p id="dashboard-message" class="dashboard-message" role="status">Verifying admin access...</p>
    </main>
  </div>
</body>
</html>

<script>
  import { supabase } from "../../lib/supabase";

  const message = document.querySelector<HTMLParagraphElement>("#dashboard-message");
  const logoutButton = document.querySelector<HTMLButtonElement>("#logout-button");

  const animeCount = document.querySelector<HTMLElement>("#anime-count");
  const articleCount = document.querySelector<HTMLElement>("#article-count");
  const publishedCount = document.querySelector<HTMLElement>("#published-count");

  async function loadDashboard() {
    try {
      const { data: sessionData, error: sessionError } =
        await supabase.auth.getSession();

      const user = sessionData.session?.user;

      if (sessionError || !user) {
        window.location.replace("/admin/login/");
        return;
      }

      const { data: admin, error: adminError } = await supabase
        .from("admin_users")
        .select("user_id")
        .eq("user_id", user.id)
        .maybeSingle();

      if (adminError || !admin) {
        await supabase.auth.signOut();
        window.location.replace("/admin/login/");
        return;
      }

      if (message) {
        message.textContent = `Admin verified: ${user.email}`;
        message.className = "dashboard-message success";
      }

      const [animeResult, articleResult, publishedResult] = await Promise.all([
        supabase.from("anime").select("id", { count: "exact", head: true }),
        supabase.from("articles").select("id", { count: "exact", head: true }),
        supabase.from("articles").select("id", { count: "exact", head: true }).eq("status", "published"),
      ]);

      if (animeCount) {
        animeCount.textContent = animeResult.error ? "Error" : String(animeResult.count ?? 0);
      }

      if (articleCount) {
        articleCount.textContent = articleResult.error ? "Error" : String(articleResult.count ?? 0);
      }

      if (publishedCount) {
        publishedCount.textContent = publishedResult.error ? "Error" : String(publishedResult.count ?? 0);
      }

      if (animeResult.error || articleResult.error || publishedResult.error) {
        if (message) {
          message.textContent = "Admin verified, but some database statistics could not be loaded.";
          message.className = "dashboard-message warning";
        }
      }
    } catch (error) {
      console.error("Dashboard error:", error);
      window.location.replace("/admin/login/");
    }
  }

  logoutButton?.addEventListener("click", async () => {
    logoutButton.disabled = true;
    logoutButton.textContent = "Signing out...";

    const { error } = await supabase.auth.signOut();

    if (error) {
      alert("Logout failed. Please try again.");
      logoutButton.disabled = false;
      logoutButton.textContent = "↪ Logout";
      return;
    }

    window.location.replace("/admin/login/");
  });

  loadDashboard();
</script>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #0b0713;
    color: #f7f1ff;
    font-family: Arial, sans-serif;
  }

  .admin-layout {
    min-height: 100vh;
    display: flex;
  }

  .sidebar {
    width: 250px;
    min-height: 100vh;
    padding: 30px 18px;
    display: flex;
    flex-direction: column;
    background: #100b1b;
    border-right: 1px solid #2c1d40;
    flex-shrink: 0;
  }

  .brand {
    margin: 0 0 48px 10px;
    color: #fff;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 3px;
    text-decoration: none;
  }

  .brand span {
    color: #bd83ff;
  }

  .sidebar-label {
    margin: 15px 10px 12px;
    color: #766787;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 12px;
    margin-bottom: 6px;
    border-radius: 9px;
    color: #b7a9c8;
    font-size: 13px;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .nav-link:hover {
    background: rgba(156, 91, 227, 0.13);
    color: #e1caff;
  }

  .nav-link.active {
    background: rgba(156, 91, 227, 0.17);
    color: #d4afff;
    border: 1px solid rgba(171, 110, 242, 0.22);
  }

  .sidebar-bottom {
    margin-top: auto;
    display: grid;
    gap: 10px;
  }

  .website-link,
  .logout-button {
    padding: 12px;
    border: 1px solid #39264f;
    border-radius: 9px;
    background: transparent;
    color: #cdb6e8;
    text-align: center;
    text-decoration: none;
    font-size: 12px;
    cursor: pointer;
  }

  .logout-button {
    color: #ffaaaa;
    border-color: #58313e;
  }

  .main-content {
    width: calc(100% - 250px);
    max-width: 1500px;
    padding: 42px;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 32px;
  }

  .eyebrow,
  .welcome-tag {
    color: #b987f0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  h1 {
    margin: 10px 0 0;
    font-size: 32px;
  }

  .admin-badge {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 14px;
    border: 1px solid #3a2a4d;
    border-radius: 30px;
    color: #d6c8e5;
    font-size: 12px;
  }

  .online-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #8de2a9;
  }

  .welcome-panel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    padding: 32px;
    border: 1px solid rgba(169, 105, 236, 0.35);
    border-radius: 17px;
    background: linear-gradient(115deg, #251536, #171020);
    box-shadow: 0 10px 40px rgba(100, 47, 156, 0.10);
  }

  .welcome-panel h2 {
    margin: 13px 0 10px;
    font-size: 25px;
  }

  .welcome-panel p,
  .section-heading p {
    max-width: 650px;
    margin: 0;
    color: #a99bb9;
    font-size: 13px;
    line-height: 1.7;
  }

  .welcome-icon {
    color: #c18bff;
    font-size: 55px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 24px;
  }

  .stat-card {
    padding: 22px;
    border: 1px solid #30213f;
    border-radius: 14px;
    background: #151020;
  }

  .stat-top {
    display: flex;
    justify-content: space-between;
    color: #b9abc9;
    font-size: 13px;
  }

  .stat-icon {
    color: #bd83ff;
    font-size: 19px;
  }

  .stat-number {
    margin-top: 22px;
    font-size: 32px;
    font-weight: 800;
  }

  .stat-description {
    margin-top: 7px;
    color: #887b99;
    font-size: 11px;
  }

  .content-section {
    margin-top: 42px;
  }

  .section-heading h2 {
    margin: 0 0 8px;
    font-size: 20px;
  }

  .management-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 20px;
  }

  .management-card {
    display: block;
    padding: 25px;
    border: 1px solid #30213f;
    border-radius: 14px;
    background: #151020;
    color: inherit;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .management-card:hover {
    border-color: #9b62d1;
    background: #1d1429;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(116, 57, 173, 0.12);
  }

  .management-icon {
    color: #c18bff;
    font-size: 27px;
  }

  .management-card h3 {
    margin: 16px 0 9px;
    font-size: 17px;
  }

  .management-card p {
    min-height: 44px;
    margin: 0 0 17px;
    color: #a99bb9;
    font-size: 12px;
    line-height: 1.7;
  }

  .open-label {
    color: #c18bff;
    font-size: 11px;
    font-weight: 700;
  }

  .dashboard-message {
    margin-top: 25px;
    color: #9c8eac;
    font-size: 12px;
  }

  .dashboard-message.success {
    color: #8ee6ae;
  }

  .dashboard-message.warning {
    color: #f3c77f;
  }

  @media (max-width: 850px) {
    .sidebar {
      width: 205px;
    }

    .main-content {
      width: calc(100% - 205px);
      padding: 25px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .admin-layout {
      display: block;
    }

    .sidebar {
      width: 100%;
      min-height: auto;
      padding: 18px;
      border-right: 0;
      border-bottom: 1px solid #2c1d40;
    }

    .brand {
      margin: 0 0 15px 5px;
    }

    .sidebar-label {
      margin-top: 12px;
    }

    .sidebar-bottom {
      margin-top: 15px;
      grid-template-columns: 1fr 1fr;
    }

    .main-content {
      width: 100%;
      padding: 25px 18px;
    }

    .topbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .welcome-panel {
      padding: 23px;
    }

    .welcome-icon {
      display: none;
    }

    .management-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
