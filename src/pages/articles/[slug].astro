
---
import Footer from "../../components/Footer.astro";
import {
  getPublishedArticles,
  getPublishedArticleBySlug
} from "../../lib/articles";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

const title = article.seo_title || article.title;
const description =
  article.meta_description ||
  article.excerpt ||
  "Read the latest anime guide on Bezels.";

const articleDate = article.published_at
  ? new Date(article.published_at).toLocaleDateString("en", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC"
    })
  : "";

function renderNode(node: any): string {
  if (!node) return "";

  if (node.type === "text") {
    let value = String(node.text || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");

    for (const mark of node.marks || []) {
      if (mark.type === "bold") value = `<strong>${value}</strong>`;
      if (mark.type === "italic") value = `<em>${value}</em>`;
      if (mark.type === "strike") value = `<s>${value}</s>`;
      if (mark.type === "code") value = `<code>${value}</code>`;
    }

    return value;
  }

  const content = (node.content || []).map(renderNode).join("");

  switch (node.type) {
    case "doc":
      return content;
    case "paragraph":
      return `<p>${content}</p>`;
    case "heading": {
      const level = Math.min(3, Math.max(1, node.attrs?.level || 2));
      return `<h${level}>${content}</h${level}>`;
    }
    case "bulletList":
      return `<ul>${content}</ul>`;
    case "orderedList":
      return `<ol>${content}</ol>`;
    case "listItem":
      return `<li>${content}</li>`;
    case "blockquote":
      return `<blockquote>${content}</blockquote>`;
    case "hardBreak":
      return "<br />";
    case "horizontalRule":
      return "<hr />";
    default:
      return content;
  }
}

const contentHtml = renderNode(article.content);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Bezels</title>
    <meta name="description" content={description} />
    <link
      rel="canonical"
      href={`https://bezels.site/articles/${article.slug}/`}
    />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {article.featured_image && (
      <meta property="og:image" content={article.featured_image} />
    )}

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #090714;
        color: #f4f0ff;
        font-family: Arial, sans-serif;
        min-height: 100vh;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 8%;
        border-bottom: 1px solid #292044;
      }

      .logo {
        font-size: 27px;
        font-weight: 800;
        color: white;
        text-decoration: none;
      }

      .logo span { color: #a58aff; }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
      }

      nav a {
        color: #c1b8d8;
        text-decoration: none;
        font-size: 14px;
      }

      nav a:hover { color: #b69cff; }

      .article-header {
        max-width: 850px;
        margin: auto;
        padding: 75px 22px 35px;
      }

      .category {
        color: #b69cff;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      h1 {
        font-size: clamp(34px, 5vw, 52px);
        line-height: 1.2;
        margin: 20px 0;
      }

      .excerpt {
        color: #b8afcc;
        font-size: 17px;
        line-height: 1.8;
      }

      .date {
        display: block;
        color: #9187a8;
        font-size: 13px;
        margin-top: 22px;
      }

      .featured-image {
        display: block;
        width: 100%;
        max-width: 850px;
        max-height: 480px;
        object-fit: cover;
        margin: 0 auto 45px;
        border-radius: 16px;
        border: 1px solid #38275e;
      }

      .article-body {
        max-width: 800px;
        margin: 0 auto 90px;
        padding: 0 22px;
        color: #d5cde5;
        font-size: 17px;
        line-height: 1.9;
        overflow-wrap: anywhere;
      }

      .article-body :global(h1),
      .article-body :global(h2),
      .article-body :global(h3) {
        color: white;
        line-height: 1.35;
        margin: 38px 0 16px;
      }

      .article-body :global(h1) { font-size: 34px; }
      .article-body :global(h2) { font-size: 28px; }
      .article-body :global(h3) { font-size: 22px; }

      .article-body :global(p) { margin: 0 0 22px; }

      .article-body :global(ul),
      .article-body :global(ol) {
        padding-left: 28px;
        margin: 0 0 24px;
      }

      .article-body :global(li) { margin-bottom: 10px; }

      .article-body :global(strong) { color: white; }

      .article-body :global(blockquote) {
        border-left: 3px solid #a58aff;
        padding: 12px 20px;
        margin: 25px 0;
        background: #17112b;
        border-radius: 0 10px 10px 0;
      }

      .article-body :global(hr) {
        border: 0;
        border-top: 1px solid #38275e;
        margin: 35px 0;
      }

      .article-body :global(code) {
        background: #211837;
        padding: 3px 7px;
        border-radius: 5px;
      }

      .back-link {
        display: inline-block;
        color: #b69cff;
        text-decoration: none;
        margin-top: 35px;
      }

      @media (max-width: 650px) {
        header {
          padding: 20px;
          flex-direction: column;
          gap: 18px;
        }

        nav {
          justify-content: center;
          gap: 14px;
        }

        nav a { font-size: 12px; }
        .article-header { padding-top: 50px; }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="logo" href="/">BEZELS<span>.</span></a>
      <nav>
        <a href="/">Home</a>
        <a href="/find-anime/">Find Anime</a>
        <a href="/anime-quiz/">Anime Quiz</a>
        <a href="/watchlist/">My Watchlist</a>
        <a href="/articles/">Articles</a>
      </nav>
    </header>

    <main>
      <section class="article-header">
        <span class="category">{article.category || "Anime Guide"}</span>
        <h1>{article.title}</h1>
        {article.excerpt && <p class="excerpt">{article.excerpt}</p>}
        {articleDate && <time class="date">{articleDate}</time>}
      </section>

      {article.featured_image && (
        <img
          class="featured-image"
          src={article.featured_image}
          alt={article.title}
        />
      )}

      <article class="article-body" set:html={contentHtml}></article>

      <div style="text-align:center; padding-bottom:60px;">
        <a class="back-link" href="/articles/">← Back to All Articles</a>
      </div>
    </main>

    <Footer />
  </body>
</html>
